{
  "project": {
    "name": "dear_margeaux",
    "description": "Boutique e-commerce website for selling bags through limited drops",
    "version": "0.1.0",
    "repository": "github.com/victorihuoma/dear_margeaux"
  },
  "architecture": {
    "type": "hybrid-cloudflare-aws",
    "commerce_backend": "merchant.dev",
    "frontend_framework": "astro",
    "styling": "tailwindcss",
    "database": "cloudflare-d1",
    "storage": "cloudflare-r2",
    "email": "aws-ses",
    "payments": "stripe",
    "deployment": "cloudflare-pages-and-workers"
  },
  "phases": [
    {
      "id": "phase-1",
      "name": "Repository & Infrastructure Setup",
      "tasks": [
        {
          "id": "1.1",
          "title": "Initialize monorepo with pnpm",
          "description": "Set up pnpm workspace with turbo for managing multiple packages",
          "commands": [
            "pnpm init",
            "pnpm add -Dw turbo",
            "touch pnpm-workspace.yaml turbo.json"
          ],
          "files_to_create": [
            {
              "path": "pnpm-workspace.yaml",
              "content": "packages:\n  - 'apps/*'\n  - 'packages/*'\n  - 'merchant'"
            },
            {
              "path": "turbo.json",
              "content_description": "Configure turbo with build, dev, lint pipelines"
            }
          ],
          "acceptance_criteria": [
            "pnpm workspace configured",
            "turbo.json exists with build/dev/lint pipelines",
            "pnpm install runs without errors"
          ]
        },
        {
          "id": "1.2",
          "title": "Clone and configure Merchant.dev",
          "description": "Add Merchant.dev as the commerce backend",
          "commands": [
            "git clone https://github.com/ygwyg/merchant.git merchant",
            "cd merchant && pnpm install"
          ],
          "files_to_modify": [
            {
              "path": "merchant/wrangler.toml",
              "changes": "Update name to 'dear-margeaux-api', configure D1 and R2 bindings"
            }
          ],
          "acceptance_criteria": [
            "Merchant cloned into /merchant directory",
            "wrangler.toml configured for dear_margeaux",
            "pnpm run dev starts local server"
          ]
        },
        {
          "id": "1.3",
          "title": "Create Cloudflare resources",
          "description": "Set up D1 database and R2 bucket in Cloudflare dashboard",
          "manual_steps": [
            "Log into Cloudflare dashboard",
            "Create D1 database named 'dear-margeaux-db'",
            "Create R2 bucket named 'dear-margeaux-images'",
            "Note the database_id and bucket name"
          ],
          "commands": [
            "cd merchant && wrangler d1 migrations apply dear-margeaux-db"
          ],
          "acceptance_criteria": [
            "D1 database created and migrations applied",
            "R2 bucket created",
            "wrangler.toml updated with correct IDs"
          ]
        },
        {
          "id": "1.4",
          "title": "Connect Stripe (test mode)",
          "description": "Configure Stripe test keys for payment processing",
          "manual_steps": [
            "Get Stripe test API keys from dashboard.stripe.com",
            "Add STRIPE_SECRET_KEY to wrangler.toml secrets",
            "Configure Stripe webhook endpoint"
          ],
          "commands": [
            "wrangler secret put STRIPE_SECRET_KEY"
          ],
          "acceptance_criteria": [
            "Stripe test keys configured",
            "Webhook endpoint registered in Stripe dashboard",
            "Test checkout creates Stripe session"
          ]
        },
        {
          "id": "1.5",
          "title": "Deploy Merchant API",
          "description": "Deploy commerce API to Cloudflare Workers",
          "commands": [
            "cd merchant && wrangler deploy"
          ],
          "acceptance_criteria": [
            "API deployed to *.workers.dev",
            "GET /v1/products returns empty array",
            "Health check passes"
          ]
        }
      ]
    },
    {
