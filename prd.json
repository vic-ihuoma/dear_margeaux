          "id": "4.1",
          "title": "Extend D1 schema for drops",
          "description": "Add drops table and link to products",
          "files_to_create": [
            {
              "path": "merchant/migrations/0002_add_drops.sql",
              "content_description": "CREATE TABLE drops with id, name, description, start_date, end_date, status"
            },
            {
              "path": "merchant/migrations/0003_product_drop_link.sql",
              "content_description": "ALTER products ADD drop_id REFERENCES drops(id)"
            }
          ],
          "schema": {
            "drops": {
              "id": "TEXT PRIMARY KEY",
              "name": "TEXT NOT NULL",
              "description": "TEXT",
              "slug": "TEXT UNIQUE NOT NULL",
              "start_date": "TEXT (ISO date)",
              "end_date": "TEXT (ISO date)",
              "status": "TEXT (draft|scheduled|active|ended)",
              "created_at": "TEXT",
              "updated_at": "TEXT"
            }
          },
          "acceptance_criteria": [
            "Migrations run successfully",
            "Drops table created",
            "Products can be linked to drops"
