            "cd apps && pnpm create astro@latest storefront -- --template minimal --typescript strict",
            "cd apps/storefront && pnpm astro add tailwind react"
          ],
          "files_to_create": [
            {
              "path": "apps/storefront/src/styles/global.css",
              "content_description": "Tailwind imports and CSS custom properties for design system"
            }
