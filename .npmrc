# Multi-platform binary support for Docker sandbox compatibility
# This ensures both macOS and Linux binaries are installed in node_modules
# so the same node_modules can work on host (macOS) and in Docker (Linux)

# Include current platform + Linux variants
supportedArchitectures.os=current,linux

# Include ARM64 (Apple Silicon/Docker arm64) and x64 (CI environments)
supportedArchitectures.cpu=current,arm64,x64
