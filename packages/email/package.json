{
  "name": "@dear-margeaux/email",
  "version": "0.1.0",
  "description": "Email utilities and templates for Dear Margeaux",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "email",
    "ses",
    "aws",
    "notifications"
  ],
  "license": "MIT"
}
