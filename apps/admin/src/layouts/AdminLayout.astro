---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Dear Margeaux Admin Dashboard' } = Astro.props;
const currentPath = Astro.url.pathname;

// Get user from locals (set by middleware)
const user = Astro.locals.user;
const userName = user?.name || 'Admin';
const userEmail = user?.email || 'admin@dearmargeaux.com';
const userInitial = userName.charAt(0).toUpperCase();

const navigation = [
  { name: 'Dashboard', href: '/', icon: 'home', badgeId: null },
  { name: 'Products', href: '/products', icon: 'package', badgeId: null },
  { name: 'Orders', href: '/orders', icon: 'shopping-cart', badgeId: null },
  {
    name: 'Inventory',
    href: '/inventory',
    icon: 'archive',
    badgeId: 'inventory-reorder-badge',
  },
  { name: 'Drops', href: '/drops', icon: 'calendar', badgeId: null },
  { name: 'Discounts', href: '/discounts', icon: 'tag', badgeId: null },
  { name: 'Analytics', href: '/analytics', icon: 'chart', badgeId: null },
  { name: 'Blog', href: '/blog', icon: 'document', badgeId: null },
  { name: 'Subscribers', href: '/subscribers', icon: 'users', badgeId: null },
];

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/' || currentPath === '/index.html';
  }
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Dear Margeaux Admin</title>
  </head>
  <body class="min-h-screen bg-background-tertiary">
    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar -->
      <aside class="hidden md:flex md:w-64 md:flex-col">
        <div
          class="flex flex-col flex-grow overflow-y-auto bg-background-secondary border-r border-border"
        >
          <!-- Logo -->
          <div class="flex items-center h-16 px-6 border-b border-border">
            <a href="/" class="flex items-center gap-2">
              <span class="text-xl font-semibold text-primary"
                >Dear Margeaux</span
              >
            </a>
          </div>

          <!-- Navigation -->
          <nav class="flex-1 px-4 py-4 space-y-1">
            {
              navigation.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors duration-normal',
                    isActive(item.href)
                      ? 'bg-primary-100 text-primary-700'
                      : 'text-text-secondary hover:bg-background-tertiary hover:text-text-primary',
                  ]}
                >
                  <span class="w-5 h-5 flex items-center justify-center">
                    {item.icon === 'home' && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-5 h-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
                        />
                      </svg>
                    )}
                    {item.icon === 'package' && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-5 h-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"
                        />
                      </svg>
                    )}
                    {item.icon === 'shopping-cart' && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-5 h-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
                        />
                      </svg>
                    )}
                    {item.icon === 'archive' && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-5 h-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"
                        />
                      </svg>
                    )}
                    {item.icon === 'calendar' && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-5 h-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
                        />
                      </svg>
                    )}
                    {item.icon === 'tag' && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-5 h-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"
                        />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M6 6h.008v.008H6V6Z"
                        />
                      </svg>
                    )}
                    {item.icon === 'chart' && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-5 h-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"
                        />
                      </svg>
                    )}
                    {item.icon === 'document' && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-5 h-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"
                        />
                      </svg>
                    )}
                    {item.icon === 'users' && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-5 h-5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"
                        />
                      </svg>
                    )}
                  </span>
                  <span class="flex-1">{item.name}</span>
                  {item.badgeId && (
                    <span
                      id={item.badgeId}
                      class="hidden ml-auto inline-flex items-center justify-center px-1.5 py-0.5 text-xs font-medium rounded-full bg-status-warning/20 text-status-warning"
                    />
                  )}
                </a>
              ))
            }
          </nav>

          <!-- User menu at bottom -->
          <div class="p-4 border-t border-border">
            <div class="flex items-center gap-3">
              <div
                class="w-8 h-8 rounded-full bg-primary-100 flex items-center justify-center"
              >
                <span class="text-sm font-medium text-primary-700"
                  >{userInitial}</span
                >
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-text-primary truncate">
                  {userName}
                </p>
                <p class="text-xs text-text-muted truncate">
                  {userEmail}
                </p>
              </div>
              <form method="POST" action="/api/auth/logout">
                <button
                  type="submit"
                  class="p-1.5 text-text-muted hover:text-text-primary rounded-md hover:bg-background-tertiary transition-colors duration-normal"
                  title="Sign out"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-5 h-5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15"
                    ></path>
                  </svg>
                </button>
              </form>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main content -->
      <div class="flex flex-col flex-1 overflow-hidden">
        <!-- Mobile header -->
        <header
          class="md:hidden flex items-center justify-between h-16 px-4 bg-background-secondary border-b border-border"
        >
          <a href="/" class="flex items-center gap-2">
            <span class="text-lg font-semibold text-primary">Dear Margeaux</span
            >
          </a>
          <button
            type="button"
            class="p-2 text-text-secondary hover:text-text-primary"
            id="mobile-menu-button"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-6 h-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
            </svg>
          </button>
        </header>

        <!-- Mobile menu overlay -->
        <div
          class="hidden fixed inset-0 z-50 md:hidden"
          id="mobile-menu-overlay"
        >
          <div class="fixed inset-0 bg-black/50" id="mobile-menu-backdrop">
          </div>
          <nav class="fixed inset-y-0 left-0 w-64 bg-background-secondary">
            <div
              class="flex items-center justify-between h-16 px-6 border-b border-border"
            >
              <span class="text-lg font-semibold text-primary"
                >Dear Margeaux</span
              >
              <button
                type="button"
                class="p-2 text-text-secondary hover:text-text-primary"
                id="mobile-menu-close"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-6 h-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 18 18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
            <div class="px-4 py-4 space-y-1">
              {
                navigation.map((item) => (
                  <a
                    href={item.href}
                    class:list={[
                      'flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg',
                      isActive(item.href)
                        ? 'bg-primary-100 text-primary-700'
                        : 'text-text-secondary hover:bg-background-tertiary hover:text-text-primary',
                    ]}
                  >
                    {item.name}
                  </a>
                ))
              }
            </div>
          </nav>
        </div>

        <!-- Page content -->
        <main class="flex-1 overflow-y-auto">
          <div class="p-6">
            <slot />
          </div>
        </main>
      </div>
    </div>

    <script>
      const menuButton = document.getElementById('mobile-menu-button');
      const menuOverlay = document.getElementById('mobile-menu-overlay');
      const menuBackdrop = document.getElementById('mobile-menu-backdrop');
      const menuClose = document.getElementById('mobile-menu-close');

      function toggleMenu() {
        menuOverlay?.classList.toggle('hidden');
      }

      menuButton?.addEventListener('click', toggleMenu);
      menuBackdrop?.addEventListener('click', toggleMenu);
      menuClose?.addEventListener('click', toggleMenu);

      // Fetch and display reorder count badge
      async function updateReorderBadge() {
        try {
          const response = await fetch('/api/inventory/reorder-count');
          if (response.ok) {
            const data = await response.json();
            const badge = document.getElementById('inventory-reorder-badge');
            if (badge && data.count > 0) {
              badge.textContent = data.count > 99 ? '99+' : String(data.count);
              badge.classList.remove('hidden');
            } else if (badge) {
              badge.classList.add('hidden');
            }
          }
        } catch (error) {
          // Silently fail - badge will just not show
          console.error('Failed to fetch reorder count:', error);
        }
      }

      // Update badge on page load
      updateReorderBadge();
    </script>
  </body>
</html>
