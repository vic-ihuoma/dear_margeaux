---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminMerchantClient } from '../../lib/merchant';
import type { Drop, DropStatus } from '@dear-margeaux/api';

// Fetch drops from the API
const client = getAdminMerchantClient();

let drops: Drop[] = [];
let error: string | null = null;

// Get query params for filtering
const url = Astro.url;
const statusFilter = url.searchParams.get('status') || '';
const searchQuery = url.searchParams.get('search') || '';

if (client) {
  try {
    const params: { limit: number; status?: DropStatus } = {
      limit: 100,
    };
    if (['draft', 'scheduled', 'active', 'ended'].includes(statusFilter)) {
      params.status = statusFilter as DropStatus;
    }
    const response = await client.getDrops(params);
    drops = response.items;

    // Apply client-side search filter
    if (searchQuery) {
      const query = searchQuery.toLowerCase();
      drops = drops.filter(
        (d) =>
          d.name.toLowerCase().includes(query) ||
          d.slug.toLowerCase().includes(query) ||
          d.description?.toLowerCase().includes(query)
      );
    }
  } catch (e) {
    console.error('Failed to fetch drops:', e);
    error = 'Failed to load drops. Please try again.';
  }
}

// Format date helper
function formatDate(dateString: string | null): string {
  if (!dateString) return '—';
  return new Date(dateString).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

// Get status badge styles
function getStatusBadgeClass(status: DropStatus): string {
  switch (status) {
    case 'active':
      return 'bg-status-success/10 text-status-success';
    case 'scheduled':
      return 'bg-status-info/10 text-status-info';
    case 'ended':
      return 'bg-background-tertiary text-text-muted';
    case 'draft':
    default:
      return 'bg-status-warning/10 text-status-warning';
  }
}

function getStatusLabel(status: DropStatus): string {
  return status.charAt(0).toUpperCase() + status.slice(1);
}
---

<AdminLayout title="Drops">
  <!-- Page Header -->
  <div
    class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8"
  >
    <div>
      <h1 class="text-2xl font-semibold text-text-primary">Drops</h1>
      <p class="mt-1 text-sm text-text-secondary">
        Manage your limited release collections
      </p>
    </div>
    <a
      href="/drops/new"
      class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-600 transition-colors duration-normal"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-5 h-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 4.5v15m7.5-7.5h-15"></path>
      </svg>
      Schedule Drop
    </a>
  </div>

  <!-- Filters -->
  <div
    class="bg-background-secondary rounded-xl border border-border shadow-sm mb-6"
  >
    <div class="p-4">
      <form method="GET" class="flex flex-col sm:flex-row gap-4">
        <!-- Search -->
        <div class="flex-1">
          <label for="search" class="sr-only">Search drops</label>
          <div class="relative">
            <div
              class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3"
            >
              <svg
                class="h-5 w-5 text-text-muted"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <input
              type="text"
              name="search"
              id="search"
              value={searchQuery}
              class="block w-full rounded-lg border border-border bg-background-primary py-2 pl-10 pr-3 text-sm text-text-primary placeholder:text-text-muted focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
              placeholder="Search by name or slug..."
            />
          </div>
        </div>

        <!-- Status filter -->
        <div class="sm:w-40">
          <label for="status" class="sr-only">Filter by status</label>
          <select
            name="status"
            id="status"
            class="block w-full rounded-lg border border-border bg-background-primary py-2 pl-3 pr-10 text-sm text-text-primary focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
          >
            <option value="" selected={!statusFilter}>All Status</option>
            <option value="draft" selected={statusFilter === 'draft'}
              >Draft</option
            >
            <option value="scheduled" selected={statusFilter === 'scheduled'}
              >Scheduled</option
            >
            <option value="active" selected={statusFilter === 'active'}
              >Active</option
            >
            <option value="ended" selected={statusFilter === 'ended'}
              >Ended</option
            >
          </select>
        </div>

        <!-- Submit button -->
        <button
          type="submit"
          class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-text-primary bg-background-tertiary border border-border rounded-lg hover:bg-background-primary transition-colors duration-normal"
        >
          Filter
        </button>
      </form>
    </div>
  </div>

  <!-- Drops Table -->
  <div
    class="bg-background-secondary rounded-xl border border-border shadow-sm overflow-hidden"
  >
    {
      error ? (
        <div class="p-8 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-status-error/10 mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-6 h-6 text-status-error"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"
              />
            </svg>
          </div>
          <p class="text-text-secondary">{error}</p>
        </div>
      ) : drops.length === 0 ? (
        <div class="p-8 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-background-tertiary mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-6 h-6 text-text-muted"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
              />
            </svg>
          </div>
          <h3 class="text-sm font-medium text-text-primary mb-1">
            No drops found
          </h3>
          <p class="text-sm text-text-muted mb-4">
            {searchQuery || statusFilter
              ? 'Try adjusting your filters'
              : 'Get started by scheduling your first drop'}
          </p>
          {!searchQuery && !statusFilter && (
            <a
              href="/drops/new"
              class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary-600"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-4 h-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 4.5v15m7.5-7.5h-15"
                />
              </svg>
              Schedule your first drop
            </a>
          )}
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-border">
            <thead class="bg-background-tertiary">
              <tr>
                <th
                  scope="col"
                  class="py-3.5 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-text-muted sm:pl-6"
                >
                  Drop
                </th>
                <th
                  scope="col"
                  class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-text-muted"
                >
                  Status
                </th>
                <th
                  scope="col"
                  class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-text-muted"
                >
                  Start Date
                </th>
                <th
                  scope="col"
                  class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-text-muted"
                >
                  End Date
                </th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border bg-background-secondary">
              {drops.map((drop) => (
                <tr class="hover:bg-background-tertiary/50 transition-colors duration-normal">
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 sm:pl-6">
                    <div>
                      <a
                        href={`/drops/${drop.id}`}
                        class="font-medium text-text-primary hover:text-primary transition-colors"
                      >
                        {drop.name}
                      </a>
                      <p class="text-sm text-text-muted">{drop.slug}</p>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4">
                    <span
                      class:list={[
                        'inline-flex items-center rounded-full px-2 py-1 text-xs font-medium',
                        getStatusBadgeClass(drop.status),
                      ]}
                    >
                      {getStatusLabel(drop.status)}
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-text-secondary">
                    {formatDate(drop.start_date)}
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-text-secondary">
                    {formatDate(drop.end_date)}
                  </td>
                  <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                    <a
                      href={`/drops/${drop.id}`}
                      class="text-primary hover:text-primary-600"
                    >
                      Edit<span class="sr-only">, {drop.name}</span>
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>

  <!-- Drop count -->
  {
    drops.length > 0 && (
      <p class="mt-4 text-sm text-text-muted">
        Showing {drops.length} {drops.length === 1 ? 'drop' : 'drops'}
      </p>
    )
  }
</AdminLayout>
