---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminMerchantClient } from '../../lib/merchant';
import { DropEditor } from '../../components/DropEditor';
import type { Drop, Product, DropStatus } from '@dear-margeaux/api';

const { id } = Astro.params;
const client = getAdminMerchantClient();

let drop: Drop | null = null;
let assignedProducts: Product[] = [];
let error: string | null = null;

if (client && id) {
  try {
    // Fetch the drop
    drop = await client.getDrop(id);

    // Fetch products assigned to this drop
    const dropProductsResponse = await client.getDropProducts(drop.slug, {
      limit: 100,
    });
    assignedProducts = dropProductsResponse.items;
  } catch (e) {
    console.error('Failed to fetch drop:', e);
    error = 'Drop not found or failed to load.';
  }
}

// Get status badge styles
function getStatusBadgeClass(status: DropStatus): string {
  switch (status) {
    case 'active':
      return 'bg-status-success/10 text-status-success';
    case 'scheduled':
      return 'bg-status-info/10 text-status-info';
    case 'ended':
      return 'bg-background-tertiary text-text-muted';
    case 'draft':
    default:
      return 'bg-status-warning/10 text-status-warning';
  }
}

function getStatusLabel(status: DropStatus): string {
  return status.charAt(0).toUpperCase() + status.slice(1);
}
---

<AdminLayout title={drop ? drop.name : 'Drop Not Found'}>
  {
    error || !drop ? (
      <div class="max-w-xl mx-auto text-center py-12">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-status-error/10 mb-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-8 h-8 text-status-error"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"
            />
          </svg>
        </div>
        <h1 class="text-xl font-semibold text-text-primary mb-2">
          Drop Not Found
        </h1>
        <p class="text-text-muted mb-6">
          {error || 'The drop you are looking for could not be found.'}
        </p>
        <a
          href="/drops"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-600 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
            />
          </svg>
          Back to Drops
        </a>
      </div>
    ) : (
      <>
        {/* Breadcrumb */}
        <nav class="flex items-center gap-2 text-sm mb-6">
          <a
            href="/drops"
            class="text-text-muted hover:text-text-primary transition-colors"
          >
            Drops
          </a>
          <span class="text-text-muted">/</span>
          <span class="text-text-primary">{drop.name}</span>
        </nav>

        {/* Page Header */}
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
          <div class="flex items-center gap-4">
            <div>
              <h1 class="text-2xl font-semibold text-text-primary">
                {drop.name}
              </h1>
              <p class="mt-1 text-sm text-text-muted">/{drop.slug}</p>
            </div>
            <span
              class:list={[
                'inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium',
                getStatusBadgeClass(drop.status),
              ]}
            >
              {getStatusLabel(drop.status)}
            </span>
          </div>
          <a
            href="/drops"
            class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-text-primary transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
              />
            </svg>
            Back to Drops
          </a>
        </div>

        {/* Drop Editor */}
        <DropEditor
          client:load
          drop={drop}
          assignedProducts={assignedProducts}
          deleteRedirect="/drops"
        />
      </>
    )
  }
</AdminLayout>
