---
import AdminLayout from '../../layouts/AdminLayout.astro';

// Email send type matching the API response
interface EmailSend {
  id: string;
  email_type: string;
  recipient: string;
  subject: string;
  status: 'sent' | 'failed' | 'queued';
  error_message: string | null;
  metadata: Record<string, unknown> | null;
  created_at: string;
}

interface EmailSendsResponse {
  items: EmailSend[];
  pagination: {
    has_more: boolean;
    next_cursor: string | null;
  };
}

// Get query params for filtering
const url = new URL(Astro.request.url);
const typeFilter = url.searchParams.get('email_type') || '';
const statusFilter = url.searchParams.get('status') || '';
const startDate = url.searchParams.get('start_date') || '';
const endDate = url.searchParams.get('end_date') || '';
const cursor = url.searchParams.get('cursor') || '';

// Build API request URL with filters
const apiUrl = new URL('/api/notifications', url.origin);
if (typeFilter) apiUrl.searchParams.set('email_type', typeFilter);
if (statusFilter) apiUrl.searchParams.set('status', statusFilter);
if (startDate) apiUrl.searchParams.set('start_date', startDate);
if (endDate) apiUrl.searchParams.set('end_date', endDate);
if (cursor) apiUrl.searchParams.set('cursor', cursor);
apiUrl.searchParams.set('limit', '50');

let emailSends: EmailSend[] = [];
let error: string | null = null;
let hasMore = false;
let nextCursor: string | null = null;

try {
  // Fetch from internal admin API route
  const response = await fetch(apiUrl.toString(), {
    headers: {
      Cookie: Astro.request.headers.get('Cookie') || '',
    },
  });

  if (!response.ok) {
    throw new Error(`Failed to fetch email sends: ${response.status}`);
  }

  const data: EmailSendsResponse = await response.json();
  emailSends = data.items;
  hasMore = data.pagination.has_more;
  nextCursor = data.pagination.next_cursor;
} catch (e) {
  console.error('Failed to fetch email sends:', e);
  error = 'Failed to load notifications. Please try again.';
}

// Format helpers
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

function getStatusBadgeClass(status: string): string {
  switch (status) {
    case 'sent':
      return 'bg-status-success/10 text-status-success';
    case 'failed':
      return 'bg-status-error/10 text-status-error';
    case 'queued':
      return 'bg-status-warning/10 text-status-warning';
    default:
      return 'bg-text-muted/10 text-text-muted';
  }
}

function formatEmailType(type: string): string {
  const typeMap: Record<string, string> = {
    order_confirmation: 'Order Confirmation',
    shipping_update: 'Shipping Update',
    order_status_update: 'Status Update',
    drop_launch: 'Drop Launch',
    newsletter_verification: 'Newsletter Verify',
    newsletter: 'Newsletter',
  };
  return typeMap[type] || type;
}

function getTypeIcon(type: string): string {
  switch (type) {
    case 'order_confirmation':
    case 'order_status_update':
      return 'shopping-cart';
    case 'shipping_update':
      return 'truck';
    case 'drop_launch':
      return 'rocket';
    case 'newsletter':
    case 'newsletter_verification':
      return 'mail';
    default:
      return 'mail';
  }
}

// Email type options for filter
const emailTypes = [
  { value: 'order_confirmation', label: 'Order Confirmation' },
  { value: 'shipping_update', label: 'Shipping Update' },
  { value: 'order_status_update', label: 'Status Update' },
  { value: 'drop_launch', label: 'Drop Launch' },
  { value: 'newsletter_verification', label: 'Newsletter Verify' },
  { value: 'newsletter', label: 'Newsletter' },
];
---

<AdminLayout title="Notifications">
  <!-- Page Header -->
  <div
    class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8"
  >
    <div>
      <h1 class="text-2xl font-semibold text-text-primary">
        Sent Notifications
      </h1>
      <p class="mt-1 text-sm text-text-muted">
        View all email notifications sent from your store.
      </p>
    </div>
    <div class="flex items-center gap-2 text-sm text-text-secondary">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-5 h-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
        ></path>
      </svg>
      <span>Email activity log</span>
    </div>
  </div>

  {
    error ? (
      <div class="p-8 text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-status-error/10 mb-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6 text-status-error"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"
            />
          </svg>
        </div>
        <p class="text-text-secondary">{error}</p>
      </div>
    ) : (
      <>
        {/* Filters */}
        <div class="bg-background-secondary rounded-xl border border-border shadow-sm mb-6">
          <form method="GET" class="flex flex-col lg:flex-row gap-4 p-4">
            <div class="flex items-center gap-2 flex-1">
              <label
                for="email_type"
                class="text-sm text-text-secondary whitespace-nowrap"
              >
                Type:
              </label>
              <select
                name="email_type"
                id="email_type"
                class="flex-1 px-3 py-2 text-sm border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50 bg-background-primary text-text-primary"
              >
                <option value="">All Types</option>
                {emailTypes.map((type) => (
                  <option
                    value={type.value}
                    selected={typeFilter === type.value}
                  >
                    {type.label}
                  </option>
                ))}
              </select>
            </div>
            <div class="flex items-center gap-2">
              <label
                for="status"
                class="text-sm text-text-secondary whitespace-nowrap"
              >
                Status:
              </label>
              <select
                name="status"
                id="status"
                class="px-3 py-2 text-sm border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50 bg-background-primary text-text-primary"
              >
                <option value="">All Status</option>
                <option value="sent" selected={statusFilter === 'sent'}>
                  Sent
                </option>
                <option value="failed" selected={statusFilter === 'failed'}>
                  Failed
                </option>
                <option value="queued" selected={statusFilter === 'queued'}>
                  Queued
                </option>
              </select>
            </div>
            <div class="flex items-center gap-2">
              <label
                for="start_date"
                class="text-sm text-text-secondary whitespace-nowrap"
              >
                From:
              </label>
              <input
                type="date"
                name="start_date"
                id="start_date"
                value={startDate}
                class="px-3 py-2 text-sm border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50 bg-background-primary text-text-primary"
              />
            </div>
            <div class="flex items-center gap-2">
              <label
                for="end_date"
                class="text-sm text-text-secondary whitespace-nowrap"
              >
                To:
              </label>
              <input
                type="date"
                name="end_date"
                id="end_date"
                value={endDate}
                class="px-3 py-2 text-sm border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50 bg-background-primary text-text-primary"
              />
            </div>
            <button
              type="submit"
              class="px-4 py-2 text-sm font-medium text-white bg-primary hover:bg-primary-600 rounded-lg transition-colors"
            >
              Filter
            </button>
          </form>
        </div>

        {/* Email Sends Table */}
        <div class="bg-background-secondary rounded-xl border border-border shadow-sm overflow-hidden">
          {emailSends.length === 0 ? (
            <div class="p-8 text-center">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-background-tertiary mb-4">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-6 h-6 text-text-muted"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                  />
                </svg>
              </div>
              <p class="text-text-secondary mb-4">
                {typeFilter || statusFilter || startDate || endDate
                  ? 'No notifications match your filters.'
                  : 'No notifications sent yet. Notifications will appear here when emails are sent.'}
              </p>
            </div>
          ) : (
            <>
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead>
                    <tr class="border-b border-border bg-background-tertiary">
                      <th class="text-left text-xs font-medium text-text-muted uppercase tracking-wider px-6 py-3">
                        Type
                      </th>
                      <th class="text-left text-xs font-medium text-text-muted uppercase tracking-wider px-6 py-3">
                        Recipient
                      </th>
                      <th class="text-left text-xs font-medium text-text-muted uppercase tracking-wider px-6 py-3">
                        Subject
                      </th>
                      <th class="text-left text-xs font-medium text-text-muted uppercase tracking-wider px-6 py-3">
                        Status
                      </th>
                      <th class="text-left text-xs font-medium text-text-muted uppercase tracking-wider px-6 py-3">
                        Sent At
                      </th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-border">
                    {emailSends.map((emailSend) => (
                      <tr class="hover:bg-background-tertiary/50 transition-colors">
                        <td class="px-6 py-4">
                          <div class="flex items-center gap-2">
                            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-primary/10 text-primary">
                              {getTypeIcon(emailSend.email_type) ===
                                'shopping-cart' && (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke-width="1.5"
                                  stroke="currentColor"
                                  class="w-4 h-4"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
                                  />
                                </svg>
                              )}
                              {getTypeIcon(emailSend.email_type) ===
                                'truck' && (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke-width="1.5"
                                  stroke="currentColor"
                                  class="w-4 h-4"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
                                  />
                                </svg>
                              )}
                              {getTypeIcon(emailSend.email_type) ===
                                'rocket' && (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke-width="1.5"
                                  stroke="currentColor"
                                  class="w-4 h-4"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"
                                  />
                                </svg>
                              )}
                              {getTypeIcon(emailSend.email_type) === 'mail' && (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke-width="1.5"
                                  stroke="currentColor"
                                  class="w-4 h-4"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                                  />
                                </svg>
                              )}
                            </span>
                            <span class="text-sm font-medium text-text-primary">
                              {formatEmailType(emailSend.email_type)}
                            </span>
                          </div>
                        </td>
                        <td class="px-6 py-4">
                          <span class="text-sm text-text-secondary">
                            {emailSend.recipient}
                          </span>
                        </td>
                        <td class="px-6 py-4">
                          <span
                            class="text-sm text-text-primary truncate max-w-[300px] block"
                            title={emailSend.subject}
                          >
                            {emailSend.subject}
                          </span>
                        </td>
                        <td class="px-6 py-4">
                          <span
                            class:list={[
                              'inline-flex items-center rounded-full px-2 py-1 text-xs font-medium',
                              getStatusBadgeClass(emailSend.status),
                            ]}
                            title={emailSend.error_message || undefined}
                          >
                            {emailSend.status.charAt(0).toUpperCase() +
                              emailSend.status.slice(1)}
                          </span>
                          {emailSend.error_message && (
                            <span
                              class="block text-xs text-status-error mt-1 truncate max-w-[150px]"
                              title={emailSend.error_message}
                            >
                              {emailSend.error_message}
                            </span>
                          )}
                        </td>
                        <td class="px-6 py-4">
                          <span class="text-sm text-text-secondary">
                            {formatDate(emailSend.created_at)}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="px-6 py-3 bg-background-tertiary border-t border-border flex items-center justify-between">
                <p class="text-sm text-text-muted">
                  Showing {emailSends.length} notifications
                </p>
                {hasMore && nextCursor && (
                  <a
                    href={`/notifications?cursor=${nextCursor}${typeFilter ? `&email_type=${typeFilter}` : ''}${statusFilter ? `&status=${statusFilter}` : ''}${startDate ? `&start_date=${startDate}` : ''}${endDate ? `&end_date=${endDate}` : ''}`}
                    class="text-sm font-medium text-primary hover:text-primary-600"
                  >
                    Load more
                  </a>
                )}
              </div>
            </>
          )}
        </div>
      </>
    )
  }
</AdminLayout>
