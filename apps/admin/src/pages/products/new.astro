---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { CreateProduct } from '../../components/CreateProduct';
---

<AdminLayout title="New Product">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm mb-6">
    <a
      href="/products"
      class="text-text-muted hover:text-text-primary transition-colors"
    >
      Products
    </a>
    <span class="text-text-muted">/</span>
    <span class="text-text-primary">New Product</span>
  </nav>

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-2xl font-semibold text-text-primary">Create New Product</h1>
    <p class="mt-1 text-sm text-text-secondary">
      Add a new product to your catalog. You can add variants after creating the
      product.
    </p>
  </div>

  <!-- Product Form -->
  <div class="max-w-2xl">
    <div
      class="bg-background-secondary rounded-xl border border-border shadow-sm"
    >
      <div class="px-6 py-4 border-b border-border">
        <h2 class="text-lg font-semibold text-text-primary">Product Details</h2>
      </div>
      <div class="p-6">
        <CreateProduct
          client:load
          successRedirect="/products"
          cancelRedirect="/products"
        />
      </div>
    </div>
  </div>
</AdminLayout>
