---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminMerchantClient } from '../../lib/merchant';
import InventoryAdjuster from '../../components/InventoryAdjuster';
import type { InventoryItem } from '@dear-margeaux/api';

// Fetch inventory and products from the API
const client = getAdminMerchantClient();

interface InventoryItemWithAlerts extends InventoryItem {
  low_stock_threshold: number | null;
  reorder_point: number | null;
}

let inventoryItems: InventoryItemWithAlerts[] = [];
let skuToProduct: Map<
  string,
  {
    productId: string;
    productTitle: string;
    variantTitle: string;
    low_stock_threshold: number | null;
    reorder_point: number | null;
  }
> = new Map();
let error: string | null = null;

// Get query params for filtering
const url = Astro.url;
const searchQuery = url.searchParams.get('search') || '';
const lowStockOnly = url.searchParams.get('low_stock') === 'true';
const needsReorderOnly = url.searchParams.get('needs_reorder') === 'true';

if (client) {
  try {
    // Fetch inventory items
    const inventoryParams: {
      limit: number;
      low_stock?: boolean;
      needs_reorder?: boolean;
    } = {
      limit: 100,
    };
    if (lowStockOnly) {
      inventoryParams.low_stock = true;
    }
    if (needsReorderOnly) {
      inventoryParams.needs_reorder = true;
    }
    const inventoryResponse = await client.getInventory(
      inventoryParams as Parameters<typeof client.getInventory>[0]
    );
    inventoryItems = inventoryResponse.items as InventoryItemWithAlerts[];

    // Fetch products to get SKU to product mapping
    const productsResponse = await client.getProducts({ limit: 100 });
    for (const productItem of productsResponse.items) {
      const product = await client.getProduct(productItem.id);
      for (const variant of product.variants) {
        skuToProduct.set(variant.sku, {
          productId: product.id,
          productTitle: product.title,
          variantTitle: variant.title,
          low_stock_threshold: variant.low_stock_threshold,
          reorder_point: variant.reorder_point,
        });
      }
    }

    // Apply client-side search filter
    if (searchQuery) {
      const query = searchQuery.toLowerCase();
      inventoryItems = inventoryItems.filter((item) => {
        const productInfo = skuToProduct.get(item.sku);
        return (
          item.sku.toLowerCase().includes(query) ||
          productInfo?.productTitle.toLowerCase().includes(query) ||
          productInfo?.variantTitle.toLowerCase().includes(query)
        );
      });
    }
  } catch (e) {
    console.error('Failed to fetch inventory:', e);
    error = 'Failed to load inventory. Please try again.';
  }
}

// Default threshold if not configured
const DEFAULT_LOW_STOCK_THRESHOLD = 5;

// Calculate items needing attention (low stock)
const itemsNeedingAttention = inventoryItems.filter(
  (item) =>
    item.available <= (item.low_stock_threshold ?? DEFAULT_LOW_STOCK_THRESHOLD)
).length;

// Calculate items needing reorder
const itemsNeedingReorder = inventoryItems.filter(
  (item) => item.reorder_point !== null && item.available <= item.reorder_point
).length;

// Helper to get stock status using configurable threshold
function getStockStatus(
  item: InventoryItemWithAlerts
): 'in_stock' | 'low_stock' | 'out_of_stock' {
  const threshold = item.low_stock_threshold ?? DEFAULT_LOW_STOCK_THRESHOLD;
  if (item.available <= 0) return 'out_of_stock';
  if (item.available <= threshold) return 'low_stock';
  return 'in_stock';
}

// Helper to get status badge styles
function getStatusStyles(
  status: 'in_stock' | 'low_stock' | 'out_of_stock'
): string {
  switch (status) {
    case 'in_stock':
      return 'bg-status-success/10 text-status-success';
    case 'low_stock':
      return 'bg-status-warning/10 text-status-warning';
    case 'out_of_stock':
      return 'bg-status-error/10 text-status-error';
  }
}

// Helper to get status label
function getStatusLabel(
  status: 'in_stock' | 'low_stock' | 'out_of_stock'
): string {
  switch (status) {
    case 'in_stock':
      return 'In Stock';
    case 'low_stock':
      return 'Low Stock';
    case 'out_of_stock':
      return 'Out of Stock';
  }
}
---

<AdminLayout title="Inventory">
  <!-- Page Header -->
  <div
    class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8"
  >
    <div>
      <h1 class="text-2xl font-semibold text-text-primary">Inventory</h1>
      <p class="mt-1 text-sm text-text-secondary">
        View and manage stock levels for all products
      </p>
    </div>
    <a
      href="/api/inventory/export"
      download
      class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-text-primary bg-background-secondary hover:bg-background-tertiary border border-border rounded-lg transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
        ></path>
      </svg>
      Export CSV
    </a>
  </div>

  <!-- Filters -->
  <div
    class="bg-background-secondary rounded-xl border border-border shadow-sm mb-6"
  >
    <div class="p-4">
      <form method="GET" class="flex flex-col sm:flex-row gap-4">
        <!-- Search -->
        <div class="flex-1">
          <label for="search" class="sr-only">Search inventory</label>
          <div class="relative">
            <div
              class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3"
            >
              <svg
                class="h-5 w-5 text-text-muted"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <input
              type="text"
              name="search"
              id="search"
              value={searchQuery}
              class="block w-full rounded-lg border border-border bg-background-primary py-2 pl-10 pr-3 text-sm text-text-primary placeholder:text-text-muted focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
              placeholder="Search by SKU, product, or variant..."
            />
          </div>
        </div>

        <!-- Low Stock Filter -->
        <div class="flex items-center">
          <label class="flex items-center gap-2 cursor-pointer">
            <input
              type="checkbox"
              name="low_stock"
              value="true"
              checked={lowStockOnly}
              class="h-4 w-4 rounded border-border text-primary focus:ring-primary-500"
            />
            <span class="text-sm text-text-secondary">Low stock only</span>
          </label>
        </div>

        <!-- Needs Reorder Filter -->
        <div class="flex items-center">
          <label class="flex items-center gap-2 cursor-pointer">
            <input
              type="checkbox"
              name="needs_reorder"
              value="true"
              checked={needsReorderOnly}
              class="h-4 w-4 rounded border-border text-status-warning focus:ring-status-warning"
            />
            <span class="text-sm text-text-secondary">Needs reorder</span>
          </label>
        </div>

        <!-- Submit button -->
        <button
          type="submit"
          class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-text-primary bg-background-tertiary border border-border rounded-lg hover:bg-background-primary transition-colors duration-normal"
        >
          Filter
        </button>
      </form>
    </div>
  </div>

  <!-- Inventory Table -->
  <div
    class="bg-background-secondary rounded-xl border border-border shadow-sm overflow-hidden"
  >
    {
      error ? (
        <div class="p-8 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-status-error/10 mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-6 h-6 text-status-error"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"
              />
            </svg>
          </div>
          <p class="text-text-secondary">{error}</p>
        </div>
      ) : inventoryItems.length === 0 ? (
        <div class="p-8 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-background-tertiary mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-6 h-6 text-text-muted"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125"
              />
            </svg>
          </div>
          <h3 class="text-sm font-medium text-text-primary mb-1">
            No inventory found
          </h3>
          <p class="text-sm text-text-muted">
            {searchQuery || lowStockOnly
              ? 'Try adjusting your filters'
              : 'Create products with variants to track inventory'}
          </p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-border">
            <thead class="bg-background-tertiary">
              <tr>
                <th
                  scope="col"
                  class="py-3.5 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-text-muted sm:pl-6"
                >
                  Product / Variant
                </th>
                <th
                  scope="col"
                  class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-text-muted"
                >
                  SKU
                </th>
                <th
                  scope="col"
                  class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-text-muted"
                >
                  Status
                </th>
                <th
                  scope="col"
                  class="px-3 py-3.5 text-center text-xs font-medium uppercase tracking-wide text-text-muted"
                >
                  On Hand
                </th>
                <th
                  scope="col"
                  class="px-3 py-3.5 text-center text-xs font-medium uppercase tracking-wide text-text-muted"
                >
                  Reserved
                </th>
                <th
                  scope="col"
                  class="px-3 py-3.5 text-center text-xs font-medium uppercase tracking-wide text-text-muted"
                >
                  Available
                </th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border bg-background-secondary">
              {inventoryItems.map((item) => {
                const productInfo = skuToProduct.get(item.sku);
                const status = getStockStatus(item);
                return (
                  <tr class="hover:bg-background-tertiary/50 transition-colors duration-normal">
                    <td class="whitespace-nowrap py-4 pl-4 pr-3 sm:pl-6">
                      <div>
                        {productInfo ? (
                          <>
                            <a
                              href={`/products/${productInfo.productId}`}
                              class="font-medium text-text-primary hover:text-primary transition-colors"
                            >
                              {productInfo.productTitle}
                            </a>
                            <p class="text-sm text-text-muted">
                              {productInfo.variantTitle}
                            </p>
                          </>
                        ) : (
                          <span class="text-text-muted">Unknown product</span>
                        )}
                      </div>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-text-secondary font-mono">
                      {item.sku}
                    </td>
                    <td class="whitespace-nowrap px-3 py-4">
                      <span
                        class:list={[
                          'inline-flex items-center rounded-full px-2 py-1 text-xs font-medium',
                          getStatusStyles(status),
                        ]}
                      >
                        {getStatusLabel(status)}
                      </span>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-text-primary text-center font-medium">
                      {item.on_hand}
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-text-secondary text-center">
                      {item.reserved}
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-center">
                      <span
                        class:list={[
                          'font-medium',
                          item.available <= 0
                            ? 'text-status-error'
                            : item.available <=
                                (item.low_stock_threshold ??
                                  DEFAULT_LOW_STOCK_THRESHOLD)
                              ? 'text-status-warning'
                              : 'text-status-success',
                        ]}
                      >
                        {item.available}
                      </span>
                    </td>
                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                      <div class="flex items-center justify-end gap-2">
                        <a
                          href={`/inventory/${item.sku}/history`}
                          class="text-text-muted hover:text-primary transition-colors"
                          title="View history"
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="w-5 h-5"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                            />
                          </svg>
                        </a>
                        <InventoryAdjuster
                          client:load
                          sku={item.sku}
                          currentOnHand={item.on_hand}
                          currentAvailable={item.available}
                        />
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )
    }
  </div>

  <!-- Inventory count -->
  {
    inventoryItems.length > 0 && (
      <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm text-text-muted">
          Showing {inventoryItems.length}{' '}
          {inventoryItems.length === 1 ? 'item' : 'items'}
        </p>
        <div class="flex flex-wrap gap-4">
          {itemsNeedingReorder > 0 && (
            <p class="text-sm text-status-warning flex items-center gap-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-4 h-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"
                />
              </svg>
              {itemsNeedingReorder} need reorder
            </p>
          )}
          {itemsNeedingAttention > 0 && (
            <p class="text-sm text-status-error flex items-center gap-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-4 h-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"
                />
              </svg>
              {itemsNeedingAttention} low stock
            </p>
          )}
        </div>
      </div>
    )
  }
</AdminLayout>
