---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard">
  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-2xl font-semibold text-text-primary">Dashboard</h1>
    <p class="mt-1 text-sm text-text-secondary">
      Welcome back! Here's an overview of your store.
    </p>
  </div>

  <!-- Quick Stats -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div
      class="bg-background-secondary rounded-xl p-6 border border-border shadow-sm"
    >
      <div class="flex items-center gap-4">
        <div
          class="w-12 h-12 rounded-lg bg-primary-100 flex items-center justify-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6 text-primary-600"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"
            ></path>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-text-secondary">Total Products</p>
          <p class="text-2xl font-semibold text-text-primary">0</p>
        </div>
      </div>
    </div>

    <div
      class="bg-background-secondary rounded-xl p-6 border border-border shadow-sm"
    >
      <div class="flex items-center gap-4">
        <div
          class="w-12 h-12 rounded-lg bg-accent-100 flex items-center justify-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6 text-accent-600"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
            ></path>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-text-secondary">Total Orders</p>
          <p class="text-2xl font-semibold text-text-primary">0</p>
        </div>
      </div>
    </div>

    <div
      class="bg-background-secondary rounded-xl p-6 border border-border shadow-sm"
    >
      <div class="flex items-center gap-4">
        <div
          class="w-12 h-12 rounded-lg bg-status-success/20 flex items-center justify-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6 text-status-success"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
            ></path>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-text-secondary">Revenue (30d)</p>
          <p class="text-2xl font-semibold text-text-primary">$0.00</p>
        </div>
      </div>
    </div>

    <div
      class="bg-background-secondary rounded-xl p-6 border border-border shadow-sm"
    >
      <div class="flex items-center gap-4">
        <div
          class="w-12 h-12 rounded-lg bg-secondary-400 flex items-center justify-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6 text-primary-700"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
            ></path>
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-text-secondary">Active Drop</p>
          <p class="text-2xl font-semibold text-text-primary">None</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Two column layout -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Recent Activity -->
    <div
      class="bg-background-secondary rounded-xl border border-border shadow-sm"
    >
      <div class="px-6 py-4 border-b border-border">
        <h2 class="text-lg font-semibold text-text-primary">Recent Activity</h2>
      </div>
      <div class="p-6">
        <div class="flex flex-col items-center justify-center py-8 text-center">
          <div
            class="w-12 h-12 rounded-full bg-background-tertiary flex items-center justify-center mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-6 h-6 text-text-muted"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
            </svg>
          </div>
          <p class="text-sm text-text-secondary">No recent activity</p>
          <p class="text-xs text-text-muted mt-1">
            Orders and product updates will appear here
          </p>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div
      class="bg-background-secondary rounded-xl border border-border shadow-sm"
    >
      <div class="px-6 py-4 border-b border-border">
        <h2 class="text-lg font-semibold text-text-primary">Quick Actions</h2>
      </div>
      <div class="p-6 space-y-3">
        <a
          href="/products/new"
          class="flex items-center gap-3 p-3 rounded-lg border border-border hover:border-primary-300 hover:bg-primary-50 transition-colors duration-fast group"
        >
          <div
            class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center group-hover:bg-primary-200 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-5 h-5 text-primary-600"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 4.5v15m7.5-7.5h-15"></path>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-text-primary">Add New Product</p>
            <p class="text-xs text-text-muted">Create a new product listing</p>
          </div>
        </a>

        <a
          href="/drops/new"
          class="flex items-center gap-3 p-3 rounded-lg border border-border hover:border-accent-300 hover:bg-accent-50 transition-colors duration-fast group"
        >
          <div
            class="w-10 h-10 rounded-lg bg-accent-100 flex items-center justify-center group-hover:bg-accent-200 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-5 h-5 text-accent-600"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z"
              ></path>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-text-primary">Schedule a Drop</p>
            <p class="text-xs text-text-muted">
              Create and schedule a new collection drop
            </p>
          </div>
        </a>

        <a
          href="/orders"
          class="flex items-center gap-3 p-3 rounded-lg border border-border hover:border-status-info/50 hover:bg-status-info/5 transition-colors duration-fast group"
        >
          <div
            class="w-10 h-10 rounded-lg bg-status-info/20 flex items-center justify-center group-hover:bg-status-info/30 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-5 h-5 text-status-info"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z"
              ></path>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-text-primary">View Orders</p>
            <p class="text-xs text-text-muted">
              Manage and fulfill customer orders
            </p>
          </div>
        </a>
      </div>
    </div>
  </div>
</AdminLayout>
