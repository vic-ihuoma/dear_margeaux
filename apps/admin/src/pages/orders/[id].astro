---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminMerchantClient, formatPrice } from '../../lib/merchant';
import OrderStatusUpdater from '../../components/OrderStatusUpdater';
import OrderNotes from '../../components/OrderNotes';
import type { Order, OrderStatus } from '@dear-margeaux/api';

const { id } = Astro.params;
const client = getAdminMerchantClient();

// Get admin info from session
const user = Astro.locals.user;
const adminId = user?.id || 'dev-admin';
const adminName = user?.name || user?.email || 'Admin';

let order: Order | null = null;
let error: string | null = null;

if (!id) {
  error = 'Order ID is required';
} else if (client) {
  try {
    order = await client.getOrder(id);
  } catch (e) {
    console.error('Failed to fetch order:', e);
    error = 'Order not found or failed to load.';
  }
}

// Helper to get status badge styles
function getStatusStyles(status: OrderStatus): string {
  switch (status) {
    case 'pending':
      return 'bg-yellow-100 text-yellow-800';
    case 'paid':
      return 'bg-blue-100 text-blue-800';
    case 'processing':
      return 'bg-purple-100 text-purple-800';
    case 'shipped':
      return 'bg-indigo-100 text-indigo-800';
    case 'delivered':
      return 'bg-status-success/10 text-status-success';
    case 'refunded':
      return 'bg-orange-100 text-orange-800';
    case 'canceled':
      return 'bg-status-error/10 text-status-error';
    default:
      return 'bg-gray-100 text-gray-800';
  }
}

// Helper to format date
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  });
}

// Helper to check if order can be refunded
function canRefund(order: Order): boolean {
  return ['paid', 'processing', 'shipped', 'delivered'].includes(order.status);
}

// Helper to check if order can be updated
function canUpdateStatus(order: Order): boolean {
  return !['refunded', 'canceled'].includes(order.status);
}
---

<AdminLayout title={order ? `Order #${order.number}` : 'Order Details'}>
  {
    error ? (
      <div class="max-w-2xl mx-auto py-12">
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-status-error/10 mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-8 h-8 text-status-error"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"
              />
            </svg>
          </div>
          <h2 class="text-xl font-semibold text-text-primary mb-2">{error}</h2>
          <a
            href="/orders"
            class="inline-flex items-center gap-2 text-primary hover:text-primary-700 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
              />
            </svg>
            Back to Orders
          </a>
        </div>
      </div>
    ) : order ? (
      <>
        {/* Breadcrumb */}
        <nav class="flex items-center gap-2 text-sm text-text-muted mb-6">
          <a
            href="/orders"
            class="hover:text-text-primary transition-colors duration-normal"
          >
            Orders
          </a>
          <span>/</span>
          <span class="text-text-primary">#{order.number}</span>
        </nav>

        {/* Page Header */}
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
          <div>
            <div class="flex items-center gap-3">
              <h1 class="text-2xl font-semibold text-text-primary">
                Order #{order.number}
              </h1>
              <span
                class:list={[
                  'inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium capitalize',
                  getStatusStyles(order.status),
                ]}
              >
                {order.status}
              </span>
            </div>
            <p class="mt-1 text-sm text-text-secondary">
              {formatDate(order.created_at)}
            </p>
          </div>
          <a
            href="/orders"
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-text-primary bg-background-secondary border border-border rounded-lg hover:bg-background-tertiary transition-colors duration-normal"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
              />
            </svg>
            Back to Orders
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {/* Main content */}
          <div class="lg:col-span-2 space-y-6">
            {/* Order Items */}
            <div class="bg-background-secondary rounded-xl border border-border shadow-sm overflow-hidden">
              <div class="px-6 py-4 border-b border-border">
                <h2 class="text-lg font-medium text-text-primary">
                  Order Items
                </h2>
              </div>
              <div class="divide-y divide-border">
                {order.items.map((item) => (
                  <div class="px-6 py-4 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-4 min-w-0">
                      <div class="w-12 h-12 bg-background-tertiary rounded-lg flex items-center justify-center flex-shrink-0">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="w-6 h-6 text-text-muted"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"
                          />
                        </svg>
                      </div>
                      <div class="min-w-0">
                        <p class="font-medium text-text-primary truncate">
                          {item.title}
                        </p>
                        <p class="text-sm text-text-muted font-mono">
                          {item.sku}
                        </p>
                      </div>
                    </div>
                    <div class="text-right flex-shrink-0">
                      <p class="text-text-primary font-medium">
                        {formatPrice(item.unit_price_cents * item.qty)}
                      </p>
                      <p class="text-sm text-text-muted">
                        {item.qty} × {formatPrice(item.unit_price_cents)}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
              {/* Order Summary */}
              <div class="px-6 py-4 bg-background-tertiary/50">
                <div class="space-y-2">
                  <div class="flex justify-between text-sm">
                    <span class="text-text-secondary">Subtotal</span>
                    <span class="text-text-primary">
                      {formatPrice(order.subtotal_cents)}
                    </span>
                  </div>
                  {order.discount_cents > 0 && (
                    <div class="flex justify-between text-sm">
                      <span class="text-text-secondary">
                        Discount
                        {order.discount_code && (
                          <span class="ml-1 font-mono text-xs">
                            ({order.discount_code})
                          </span>
                        )}
                      </span>
                      <span class="text-status-success">
                        -{formatPrice(order.discount_cents)}
                      </span>
                    </div>
                  )}
                  {order.shipping_cents > 0 && (
                    <div class="flex justify-between text-sm">
                      <span class="text-text-secondary">Shipping</span>
                      <span class="text-text-primary">
                        {formatPrice(order.shipping_cents)}
                      </span>
                    </div>
                  )}
                  {order.tax_cents > 0 && (
                    <div class="flex justify-between text-sm">
                      <span class="text-text-secondary">Tax</span>
                      <span class="text-text-primary">
                        {formatPrice(order.tax_cents)}
                      </span>
                    </div>
                  )}
                  <div class="flex justify-between pt-2 border-t border-border">
                    <span class="font-medium text-text-primary">Total</span>
                    <span class="font-semibold text-text-primary">
                      {formatPrice(order.total_cents)}
                    </span>
                  </div>
                </div>
              </div>
            </div>

            {/* Fulfillment */}
            {canUpdateStatus(order) && (
              <div class="bg-background-secondary rounded-xl border border-border shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-border">
                  <h2 class="text-lg font-medium text-text-primary">
                    Fulfillment
                  </h2>
                </div>
                <div class="p-6">
                  <OrderStatusUpdater
                    client:load
                    orderId={order.id}
                    currentStatus={order.status}
                    trackingNumber={order.tracking_number || undefined}
                    trackingUrl={order.tracking_url || undefined}
                  />
                </div>
              </div>
            )}

            {/* Tracking Info (if shipped) */}
            {order.tracking_number && (
              <div class="bg-background-secondary rounded-xl border border-border shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-border">
                  <h2 class="text-lg font-medium text-text-primary">
                    Tracking Information
                  </h2>
                </div>
                <div class="p-6">
                  <dl class="space-y-4">
                    <div>
                      <dt class="text-sm font-medium text-text-muted">
                        Tracking Number
                      </dt>
                      <dd class="mt-1 text-sm text-text-primary font-mono">
                        {order.tracking_number}
                      </dd>
                    </div>
                    {order.tracking_url && (
                      <div>
                        <dt class="text-sm font-medium text-text-muted">
                          Tracking URL
                        </dt>
                        <dd class="mt-1">
                          <a
                            href={order.tracking_url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm text-primary hover:text-primary-700 transition-colors"
                          >
                            {order.tracking_url}
                          </a>
                        </dd>
                      </div>
                    )}
                  </dl>
                </div>
              </div>
            )}

            {/* Order Notes */}
            <div class="bg-background-secondary rounded-xl border border-border shadow-sm overflow-hidden">
              <div class="px-6 py-4 border-b border-border">
                <h2 class="text-lg font-medium text-text-primary">Notes</h2>
              </div>
              <div class="p-6">
                <OrderNotes
                  client:load
                  orderId={order.id}
                  adminId={adminId}
                  adminName={adminName}
                />
              </div>
            </div>
          </div>

          {/* Sidebar */}
          <div class="space-y-6">
            {/* Customer Info */}
            <div class="bg-background-secondary rounded-xl border border-border shadow-sm overflow-hidden">
              <div class="px-6 py-4 border-b border-border">
                <h2 class="text-lg font-medium text-text-primary">Customer</h2>
              </div>
              <div class="p-6">
                <dl class="space-y-4">
                  <div>
                    <dt class="text-sm font-medium text-text-muted">Email</dt>
                    <dd class="mt-1 text-sm text-text-primary">
                      <a
                        href={`mailto:${order.customer_email}`}
                        class="text-primary hover:text-primary-700 transition-colors"
                      >
                        {order.customer_email}
                      </a>
                    </dd>
                  </div>
                  {order.customer_id && (
                    <div>
                      <dt class="text-sm font-medium text-text-muted">
                        Customer ID
                      </dt>
                      <dd class="mt-1 text-sm text-text-secondary font-mono">
                        {order.customer_id}
                      </dd>
                    </div>
                  )}
                </dl>
              </div>
            </div>

            {/* Payment Info */}
            <div class="bg-background-secondary rounded-xl border border-border shadow-sm overflow-hidden">
              <div class="px-6 py-4 border-b border-border">
                <h2 class="text-lg font-medium text-text-primary">Payment</h2>
              </div>
              <div class="p-6">
                <dl class="space-y-4">
                  <div>
                    <dt class="text-sm font-medium text-text-muted">
                      Payment Status
                    </dt>
                    <dd class="mt-1">
                      <span
                        class:list={[
                          'inline-flex items-center rounded-full px-2 py-1 text-xs font-medium',
                          order.status === 'refunded'
                            ? 'bg-orange-100 text-orange-800'
                            : order.status === 'canceled'
                              ? 'bg-status-error/10 text-status-error'
                              : order.status === 'pending'
                                ? 'bg-yellow-100 text-yellow-800'
                                : 'bg-status-success/10 text-status-success',
                        ]}
                      >
                        {order.status === 'refunded'
                          ? 'Refunded'
                          : order.status === 'canceled'
                            ? 'Canceled'
                            : order.status === 'pending'
                              ? 'Pending'
                              : 'Paid'}
                      </span>
                    </dd>
                  </div>
                  {order.stripe_payment_intent_id && (
                    <div>
                      <dt class="text-sm font-medium text-text-muted">
                        Stripe Payment Intent
                      </dt>
                      <dd class="mt-1 text-xs text-text-secondary font-mono truncate">
                        {order.stripe_payment_intent_id}
                      </dd>
                    </div>
                  )}
                </dl>
              </div>
            </div>

            {/* Actions */}
            {canRefund(order) && (
              <div class="bg-background-secondary rounded-xl border border-border shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-border">
                  <h2 class="text-lg font-medium text-text-primary">Actions</h2>
                </div>
                <div class="p-6">
                  <button
                    type="button"
                    id="refund-btn"
                    data-order-id={order.id}
                    class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-white bg-status-error hover:bg-red-700 rounded-lg transition-colors duration-normal"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="w-4 h-4"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z"
                      />
                    </svg>
                    Process Refund
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      </>
    ) : (
      <div class="text-center py-12">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary mx-auto" />
      </div>
    )
  }

  <script>
    const refundBtn = document.getElementById('refund-btn');
    if (refundBtn) {
      refundBtn.addEventListener('click', async () => {
        const orderId = refundBtn.getAttribute('data-order-id');
        if (
          !confirm(
            'Are you sure you want to refund this order? This action cannot be undone.'
          )
        ) {
          return;
        }

        refundBtn.setAttribute('disabled', 'true');
        refundBtn.innerHTML = `
          <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Processing...
        `;

        try {
          const response = await fetch(`/api/orders/${orderId}/refund`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.message || 'Failed to process refund');
          }

          window.location.reload();
        } catch (error) {
          alert(
            error instanceof Error ? error.message : 'Failed to process refund'
          );
          refundBtn.removeAttribute('disabled');
          refundBtn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
            </svg>
            Process Refund
          `;
        }
      });
    }
  </script>
</AdminLayout>
