---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { AddSubscriberModal } from '../../components/AddSubscriberModal';
import { RemoveSubscriberButton } from '../../components/RemoveSubscriberButton';

// Subscriber type matching the API response
interface Subscriber {
  id: string;
  email: string;
  verified: boolean;
  subscribed_at: string;
  verified_at: string | null;
  unsubscribed_at: string | null;
  source: string;
  status: 'verified' | 'unverified' | 'unsubscribed';
}

interface SubscribersResponse {
  subscribers: Subscriber[];
  count: number;
  next_cursor: string | null;
  has_more: boolean;
}

// Get query params for filtering
const url = new URL(Astro.request.url);
const searchQuery = url.searchParams.get('search') || '';
const statusFilter = url.searchParams.get('status') || '';

// Build API request URL with filters
const apiUrl = new URL('/api/newsletter/subscribers', url.origin);
if (searchQuery) apiUrl.searchParams.set('search', searchQuery);
if (statusFilter) apiUrl.searchParams.set('status', statusFilter);
apiUrl.searchParams.set('limit', '50');

let subscribers: Subscriber[] = [];
let totalCount = 0;
let error: string | null = null;
let hasMore = false;
let nextCursor: string | null = null;

try {
  // Fetch from internal admin API route
  const response = await fetch(apiUrl.toString(), {
    headers: {
      Cookie: Astro.request.headers.get('Cookie') || '',
    },
  });

  if (!response.ok) {
    throw new Error(`Failed to fetch subscribers: ${response.status}`);
  }

  const data: SubscribersResponse = await response.json();
  subscribers = data.subscribers;
  totalCount = data.count;
  hasMore = data.has_more;
  nextCursor = data.next_cursor;
} catch (e) {
  console.error('Failed to fetch subscribers:', e);
  error = 'Failed to load subscribers. Please try again.';
}

// Format helpers
function formatDate(dateString: string | null): string {
  if (!dateString) return '-';
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

function getStatusBadgeClass(status: string): string {
  switch (status) {
    case 'verified':
      return 'bg-status-success/10 text-status-success';
    case 'unverified':
      return 'bg-status-warning/10 text-status-warning';
    case 'unsubscribed':
      return 'bg-text-muted/10 text-text-muted';
    default:
      return 'bg-text-muted/10 text-text-muted';
  }
}

function formatSource(source: string | null): string {
  if (!source) return 'Website';
  switch (source) {
    case 'footer':
      return 'Footer Form';
    case 'popup':
      return 'Popup';
    case 'blog':
      return 'Blog';
    case 'checkout':
      return 'Checkout';
    case 'admin':
      return 'Admin Added';
    default:
      return source.charAt(0).toUpperCase() + source.slice(1);
  }
}
---

<AdminLayout title="Subscribers">
  <!-- Page Header -->
  <div
    class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8"
  >
    <div>
      <h1 class="text-2xl font-semibold text-text-primary">Subscribers</h1>
      <p class="mt-1 text-sm text-text-muted">
        Manage your newsletter subscribers.
      </p>
    </div>
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2 text-sm text-text-secondary">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-5 h-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"
          ></path>
        </svg>
        <span>{totalCount} total subscribers</span>
      </div>
      <AddSubscriberModal client:load />
    </div>
  </div>

  {
    error ? (
      <div class="p-8 text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-status-error/10 mb-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6 text-status-error"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"
            />
          </svg>
        </div>
        <p class="text-text-secondary">{error}</p>
      </div>
    ) : (
      <>
        {/* Filters */}
        <div class="bg-background-secondary rounded-xl border border-border shadow-sm mb-6">
          <form method="GET" class="flex flex-col sm:flex-row gap-4 p-4">
            <div class="flex-1">
              <label for="search" class="sr-only">
                Search by email
              </label>
              <div class="relative">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                  <svg
                    class="h-5 w-5 text-text-muted"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </div>
                <input
                  type="text"
                  name="search"
                  id="search"
                  value={searchQuery}
                  placeholder="Search by email..."
                  class="w-full pl-10 pr-3 py-2 text-sm border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50 bg-background-primary text-text-primary"
                />
              </div>
            </div>
            <div class="flex items-center gap-2">
              <select
                name="status"
                class="px-3 py-2 text-sm border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50 bg-background-primary text-text-primary"
              >
                <option value="">All Status</option>
                <option value="verified" selected={statusFilter === 'verified'}>
                  Verified
                </option>
                <option
                  value="unverified"
                  selected={statusFilter === 'unverified'}
                >
                  Unverified
                </option>
                <option
                  value="unsubscribed"
                  selected={statusFilter === 'unsubscribed'}
                >
                  Unsubscribed
                </option>
              </select>
              <button
                type="submit"
                class="px-4 py-2 text-sm font-medium text-white bg-primary hover:bg-primary-600 rounded-lg transition-colors"
              >
                Filter
              </button>
            </div>
          </form>
        </div>

        {/* Subscribers Table */}
        <div class="bg-background-secondary rounded-xl border border-border shadow-sm overflow-hidden">
          {subscribers.length === 0 ? (
            <div class="p-8 text-center">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-background-tertiary mb-4">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-6 h-6 text-text-muted"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"
                  />
                </svg>
              </div>
              <p class="text-text-secondary mb-4">
                {searchQuery || statusFilter
                  ? 'No subscribers match your filters.'
                  : 'No subscribers yet. Subscribers will appear here when they sign up for your newsletter.'}
              </p>
            </div>
          ) : (
            <>
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead>
                    <tr class="border-b border-border bg-background-tertiary">
                      <th class="text-left text-xs font-medium text-text-muted uppercase tracking-wider px-6 py-3">
                        Email
                      </th>
                      <th class="text-left text-xs font-medium text-text-muted uppercase tracking-wider px-6 py-3">
                        Status
                      </th>
                      <th class="text-left text-xs font-medium text-text-muted uppercase tracking-wider px-6 py-3">
                        Subscribed
                      </th>
                      <th class="text-left text-xs font-medium text-text-muted uppercase tracking-wider px-6 py-3">
                        Source
                      </th>
                      <th class="text-right text-xs font-medium text-text-muted uppercase tracking-wider px-6 py-3">
                        Actions
                      </th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-border">
                    {subscribers.map((subscriber) => (
                      <tr class="hover:bg-background-tertiary/50 transition-colors">
                        <td class="px-6 py-4">
                          <span class="text-sm font-medium text-text-primary">
                            {subscriber.email}
                          </span>
                        </td>
                        <td class="px-6 py-4">
                          <span
                            class:list={[
                              'inline-flex items-center rounded-full px-2 py-1 text-xs font-medium',
                              getStatusBadgeClass(subscriber.status),
                            ]}
                          >
                            {subscriber.status.charAt(0).toUpperCase() +
                              subscriber.status.slice(1)}
                          </span>
                        </td>
                        <td class="px-6 py-4">
                          <span class="text-sm text-text-secondary">
                            {formatDate(subscriber.subscribed_at)}
                          </span>
                        </td>
                        <td class="px-6 py-4">
                          <span class="text-sm text-text-secondary">
                            {formatSource(subscriber.source)}
                          </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                          {subscriber.status !== 'unsubscribed' ? (
                            <RemoveSubscriberButton
                              client:load
                              subscriberId={subscriber.id}
                              email={subscriber.email}
                            />
                          ) : (
                            <span class="text-xs text-text-muted">-</span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="px-6 py-3 bg-background-tertiary border-t border-border flex items-center justify-between">
                <p class="text-sm text-text-muted">
                  Showing {subscribers.length} of {totalCount}{' '}
                  {totalCount === 1 ? 'subscriber' : 'subscribers'}
                </p>
                {hasMore && nextCursor && (
                  <a
                    href={`/subscribers?cursor=${nextCursor}${statusFilter ? `&status=${statusFilter}` : ''}${searchQuery ? `&search=${searchQuery}` : ''}`}
                    class="text-sm font-medium text-primary hover:text-primary-600"
                  >
                    Load more
                  </a>
                )}
              </div>
            </>
          )}
        </div>
      </>
    )
  }
</AdminLayout>
