# Dear Margeaux Admin Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# MERCHANT API CONFIGURATION
# =============================================================================

# The base URL for the Merchant.dev API (server-side calls)
# Development: http://localhost:8787
# Production: https://api.dearmargeaux.com
MERCHANT_API_URL=http://localhost:8787

# Admin API key for full access (NEVER expose to client)
# Use sk_ prefix for secret keys
# Development: sk_dev_xxxxx (from local Merchant dev server)
# Production: sk_live_xxxxx (from Cloudflare Merchant secrets)
MERCHANT_ADMIN_KEY=sk_dev_xxxxx

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Session secret for encrypting admin session cookies
# Generate with: openssl rand -base64 32
# IMPORTANT: Use a different value in production!
SESSION_SECRET=your_secure_session_secret_here

# =============================================================================
# D1 DATABASE (only needed for server-side rendering with D1)
# =============================================================================

# Cloudflare D1 database binding name (matches wrangler.jsonc)
# This is automatically available in Cloudflare Pages Functions
# D1_DATABASE_BINDING=DB

# =============================================================================
# OPTIONAL: SENTRY ERROR MONITORING
# =============================================================================

# Sentry DSN for admin error tracking (optional, separate from storefront)
# PUBLIC_SENTRY_DSN=
# PUBLIC_SENTRY_ENVIRONMENT=development
