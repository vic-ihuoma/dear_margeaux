---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer';

interface Props {
  title: string;
  drop: string;
  date: Date;
  images: string[];
}

const { title, drop, date, images } = Astro.props;

// Format date
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});

// Create a readable drop title from slug
const dropTitle = drop
  .split('-')
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title} | Dear Margeaux Lookbook</title>
    <meta name="description" content={`${title} lookbook from Dear Margeaux`} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${title} | Dear Margeaux Lookbook`} />
    <meta
      property="og:description"
      content={`${title} lookbook from Dear Margeaux`}
    />
    {images.length > 0 && <meta property="og:image" content={images[0]} />}

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content={images.length > 0 ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={`${title} | Dear Margeaux Lookbook`} />
    <meta
      name="twitter:description"
      content={`${title} lookbook from Dear Margeaux`}
    />
    {images.length > 0 && <meta name="twitter:image" content={images[0]} />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <!-- Breadcrumb -->
      <nav class="bg-background-tertiary py-3 border-b border-border">
        <div class="container mx-auto px-4 max-w-6xl">
          <ol class="flex items-center gap-2 text-sm">
            <li>
              <a
                href="/"
                class="text-text-secondary hover:text-primary transition-colors duration-normal"
              >
                Home
              </a>
            </li>
            <li class="text-text-muted">/</li>
            <li>
              <a
                href="/lookbook"
                class="text-text-secondary hover:text-primary transition-colors duration-normal"
              >
                Lookbook
              </a>
            </li>
            <li class="text-text-muted">/</li>
            <li class="text-text font-medium truncate max-w-[200px]">
              {title}
            </li>
          </ol>
        </div>
      </nav>

      <!-- Lookbook Header -->
      <section class="py-8 md:py-12">
        <div class="container mx-auto px-4 max-w-6xl text-center">
          <div class="mb-4">
            <a
              href={`/shop/${drop}`}
              class="inline-flex items-center gap-2 px-3 py-1 text-xs font-medium uppercase tracking-wider text-accent bg-accent/10 rounded-full hover:bg-accent/20 transition-colors duration-normal"
            >
              {dropTitle} Collection
              <svg
                class="w-3 h-3"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
              </svg>
            </a>
          </div>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text mb-4">
            {title}
          </h1>
          <p class="text-text-secondary">
            {formattedDate}
          </p>
        </div>
      </section>

      <!-- Hero Image (First Image Full Width) -->
      {
        images.length > 0 && (
          <section class="mb-8 md:mb-12">
            <div class="w-full">
              <div class="aspect-[16/9] md:aspect-[21/9] overflow-hidden">
                <img
                  src={images[0]}
                  alt={`${title} - Hero`}
                  class="w-full h-full object-cover"
                />
              </div>
            </div>
          </section>
        )
      }

      <!-- Lookbook Content -->
      <article class="py-8 md:py-12">
        <div class="container mx-auto px-4 max-w-4xl">
          <div
            class="prose prose-lg prose-slate max-w-none
              prose-headings:font-bold prose-headings:text-text
              prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
              prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
              prose-p:text-text-secondary prose-p:leading-relaxed
              prose-a:text-primary prose-a:no-underline hover:prose-a:underline
              prose-strong:text-text prose-strong:font-semibold
              prose-em:text-text-secondary"
          >
            <slot />
          </div>
        </div>
      </article>

      <!-- Image Gallery (Remaining Images) -->
      {
        images.length > 1 && (
          <section class="py-8 md:py-12 bg-secondary">
            <div class="container mx-auto px-4 max-w-6xl">
              <h2 class="text-2xl font-bold text-text text-center mb-8">
                Gallery
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                {images.slice(1).map((image, index) => (
                  <div
                    class:list={[
                      'overflow-hidden rounded-xl',
                      // Make every third image span full width for visual interest
                      (index + 1) % 3 === 0 && 'md:col-span-2',
                    ]}
                  >
                    <div
                      class:list={[
                        'overflow-hidden',
                        (index + 1) % 3 === 0
                          ? 'aspect-[21/9]'
                          : 'aspect-[4/5]',
                      ]}
                    >
                      <img
                        src={image}
                        alt={`${title} - Image ${index + 2}`}
                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                      />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )
      }

      <!-- Shop the Collection CTA -->
      <section class="py-12 md:py-16">
        <div class="container mx-auto px-4 max-w-4xl text-center">
          <h2 class="text-2xl font-bold text-text mb-3">
            Shop the {dropTitle} Collection
          </h2>
          <p class="text-text-secondary max-w-md mx-auto mb-6">
            Discover the pieces featured in this lookbook
          </p>
          <div
            class="flex flex-col sm:flex-row items-center justify-center gap-4"
          >
            <a
              href={`/shop/${drop}`}
              class="inline-flex px-6 py-3 bg-primary text-text-inverse font-medium rounded-lg hover:bg-primary-600 transition-colors duration-normal"
            >
              Shop {dropTitle}
            </a>
            <a
              href="/lookbook"
              class="inline-flex items-center gap-2 text-primary font-medium hover:gap-3 transition-all duration-normal"
            >
              <svg
                class="w-4 h-4 rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
              </svg>
              Back to Lookbook
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
    <!-- Cart Drawer (React component hydrated on client) -->
    <CartDrawer client:load />
  </body>
</html>
