---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class:list={['bg-background-secondary border-t border-border', className]}>
  <div class="container mx-auto px-4 py-12 max-w-6xl">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand Column -->
      <div class="md:col-span-2">
        <a href="/" class="inline-block">
          <span class="text-xl font-bold text-text tracking-tight">Dear Margeaux</span>
        </a>
        <p class="mt-4 text-sm text-text-secondary max-w-sm">
          Boutique bags crafted with care. Limited drops, timeless style.
        </p>
        <!-- Social Icons -->
        <div class="flex gap-4 mt-6">
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow us on Instagram"
            class="p-2 text-text-muted hover:text-text transition-colors duration-normal"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="https://twitter.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow us on X (Twitter)"
            class="p-2 text-text-muted hover:text-text transition-colors duration-normal"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a
            href="https://pinterest.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow us on Pinterest"
            class="p-2 text-text-muted hover:text-text transition-colors duration-normal"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Shop Links -->
      <div>
        <h3 class="text-sm font-semibold text-text uppercase tracking-wider mb-4">Shop</h3>
        <ul class="space-y-3">
          <li>
            <a href="/shop" class="text-sm text-text-secondary hover:text-text transition-colors duration-normal">
              All Products
            </a>
          </li>
          <li>
            <a href="/drops" class="text-sm text-text-secondary hover:text-text transition-colors duration-normal">
              Current Drops
            </a>
          </li>
          <li>
            <a href="/drops/archive" class="text-sm text-text-secondary hover:text-text transition-colors duration-normal">
              Past Drops
            </a>
          </li>
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h3 class="text-sm font-semibold text-text uppercase tracking-wider mb-4">Company</h3>
        <ul class="space-y-3">
          <li>
            <a href="/about" class="text-sm text-text-secondary hover:text-text transition-colors duration-normal">
              About
            </a>
          </li>
          <li>
            <a href="/contact" class="text-sm text-text-secondary hover:text-text transition-colors duration-normal">
              Contact
            </a>
          </li>
          <li>
            <a href="/shipping" class="text-sm text-text-secondary hover:text-text transition-colors duration-normal">
              Shipping
            </a>
          </li>
          <li>
            <a href="/returns" class="text-sm text-text-secondary hover:text-text transition-colors duration-normal">
              Returns
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Newsletter Signup -->
    <div class="mt-12 pt-8 border-t border-border">
      <div class="max-w-md">
        <h3 class="text-sm font-semibold text-text uppercase tracking-wider mb-2">Stay in the loop</h3>
        <p class="text-sm text-text-secondary mb-4">
          Be the first to know about new drops and exclusive offers.
        </p>
        <form class="flex gap-2" id="newsletter-form">
          <input
            type="email"
            name="email"
            placeholder="Enter your email"
            required
            class="flex-1 px-4 py-2 text-sm bg-background border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-shadow duration-normal"
          />
          <button
            type="submit"
            class="px-6 py-2 bg-primary text-text-inverse text-sm font-medium rounded-lg hover:bg-primary-600 transition-colors duration-normal"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 pt-8 border-t border-border flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-text-muted">
        &copy; {currentYear} Dear Margeaux. All rights reserved.
      </p>
      <div class="flex gap-6">
        <a href="/privacy" class="text-xs text-text-muted hover:text-text transition-colors duration-normal">
          Privacy Policy
        </a>
        <a href="/terms" class="text-xs text-text-muted hover:text-text transition-colors duration-normal">
          Terms of Service
        </a>
      </div>
    </div>
  </div>
</footer>
