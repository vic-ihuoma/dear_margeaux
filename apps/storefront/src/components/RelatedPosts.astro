---
import type { BlogPost } from '../lib/blog';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;

/**
 * Format date for display
 */
function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

{
  posts.length > 0 && (
    <section class="mt-12 pt-8 border-t border-border">
      <h2 class="text-xl font-bold text-text mb-6">Related Posts</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group block bg-background-tertiary rounded-lg overflow-hidden hover:shadow-md transition-shadow duration-normal"
          >
            {/* Image */}
            {post.data.image ? (
              <div class="aspect-[16/10] overflow-hidden">
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
            ) : (
              <div class="aspect-[16/10] bg-secondary flex items-center justify-center">
                <svg
                  class="w-8 h-8 text-text-muted"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                  />
                </svg>
              </div>
            )}

            {/* Content */}
            <div class="p-4">
              {/* Tags */}
              {post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1 mb-2">
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="text-xs font-medium text-accent uppercase tracking-wider">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              {/* Title */}
              <h3 class="font-semibold text-text line-clamp-2 group-hover:text-primary transition-colors duration-normal mb-2">
                {post.data.title}
              </h3>

              {/* Date */}
              <time
                datetime={post.data.date.toISOString()}
                class="text-sm text-text-secondary"
              >
                {formatDate(post.data.date)}
              </time>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}
