---
interface Props {
  label: string;
  id: string;
  defaultOpen?: boolean;
}

const { label, id, defaultOpen = false } = Astro.props;
const toggleId = `${id}-toggle`;
const contentId = `${id}-content`;
const chevronId = `${id}-chevron`;
---

<div class="collapsible-filter" data-filter-id={id}>
  <button
    type="button"
    id={toggleId}
    class="flex items-center gap-2 text-sm font-medium text-text-secondary hover:text-text transition-colors duration-normal"
    aria-expanded={defaultOpen ? 'true' : 'false'}
    aria-controls={contentId}
  >
    <svg
      class="w-4 h-4 transition-transform duration-200"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"
      ></path>
    </svg>
    {label}
    <svg
      id={chevronId}
      class:list={[
        'w-4 h-4 transition-transform duration-200',
        defaultOpen && 'rotate-180',
      ]}
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </button>
  <div
    id={contentId}
    class:list={[
      'mt-4 flex-wrap items-center gap-3',
      defaultOpen ? 'flex' : 'hidden',
    ]}
  >
    <slot />
  </div>
</div>

<script>
  // Handle all collapsible filters on the page
  document.querySelectorAll('.collapsible-filter').forEach((filter) => {
    const id = filter.getAttribute('data-filter-id');
    const toggle = document.getElementById(`${id}-toggle`);
    const content = document.getElementById(`${id}-content`);
    const chevron = document.getElementById(`${id}-chevron`);

    toggle?.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

      // Toggle visibility
      content?.classList.toggle('hidden');
      content?.classList.toggle('flex');

      // Update aria-expanded
      toggle.setAttribute('aria-expanded', (!isExpanded).toString());

      // Rotate chevron
      chevron?.classList.toggle('rotate-180');
    });
  });
</script>
