---
interface Props {
  id: string;
  title: string;
  price: number;
  currency?: string;
  image?: string;
  imageAlt?: string;
  collection?: string;
  soldOut?: boolean;
  href?: string;
  class?: string;
}

const {
  id,
  title,
  price,
  currency = 'USD',
  image,
  imageAlt = title,
  collection,
  soldOut = false,
  href,
  class: className,
} = Astro.props;

const formattedPrice = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency,
}).format(price / 100);

const productUrl = href || `/product/${id}`;
---

<article class:list={['group relative', className]}>
  <a href={productUrl} class="block">
    <!-- Image Container -->
    <div class="relative aspect-square overflow-hidden rounded-lg bg-secondary">
      {image ? (
        <img
          src={image}
          alt={imageAlt}
          class="h-full w-full object-cover object-center transition-transform duration-slow group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center">
          <svg
            class="h-12 w-12 text-text-muted"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
            />
          </svg>
        </div>
      )}

      <!-- Sold Out Badge -->
      {soldOut && (
        <div class="absolute inset-0 flex items-center justify-center bg-background-inverse/60">
          <span class="px-4 py-2 bg-background text-text text-sm font-semibold rounded-full">
            Sold Out
          </span>
        </div>
      )}
    </div>

    <!-- Product Info -->
    <div class="mt-4 space-y-1">
      {collection && (
        <p class="text-xs text-text-muted uppercase tracking-wider">{collection}</p>
      )}
      <h3 class="text-sm font-medium text-text group-hover:text-primary transition-colors duration-normal">
        {title}
      </h3>
      <p class:list={[
        'text-sm font-semibold',
        soldOut ? 'text-text-muted line-through' : 'text-primary'
      ]}>
        {formattedPrice}
      </p>
    </div>
  </a>
</article>
