---
interface Props {
  columns?: 1 | 2 | 3 | 4;
  gap?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { columns = 4, gap = 'md', class: className } = Astro.props;

const gridCols = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
};

const gapSize = {
  sm: 'gap-4',
  md: 'gap-6',
  lg: 'gap-8',
};
---

<div class:list={['grid', gridCols[columns], gapSize[gap], className]}>
  <slot />
</div>
