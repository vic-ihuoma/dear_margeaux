---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Get all published blog posts, sorted by date (newest first)
const allPosts = await getCollection('blog', ({ data }) => {
  // In production, filter out drafts
  return import.meta.env.PROD ? !data.draft : true;
});

const posts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Format date helper
function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout
  title="Blog"
  description="News, stories, and behind-the-scenes from Dear Margeaux"
>
  <!-- Page Header -->
  <section class="bg-secondary py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-4xl">
      <h1 class="text-3xl md:text-4xl font-bold text-text text-center">
        The Journal
      </h1>
      <p class="text-text-secondary text-center mt-3 max-w-xl mx-auto">
        Stories, insights, and behind-the-scenes from Dear Margeaux
      </p>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-4xl">
      {
        posts.length > 0 ? (
          <div class="space-y-12">
            {posts.map((post, index) => (
              <article
                class:list={[
                  'group',
                  index !== posts.length - 1 && 'pb-12 border-b border-border',
                ]}
              >
                <a href={`/blog/${post.slug}`} class="block">
                  {/* Featured Image */}
                  {post.data.image && (
                    <div class="aspect-[2/1] overflow-hidden rounded-xl mb-6">
                      <img
                        src={post.data.image}
                        alt={post.data.title}
                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    </div>
                  )}

                  {/* Post Meta */}
                  <div class="flex items-center gap-3 text-sm text-text-secondary mb-3">
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                    {post.data.tags.length > 0 && (
                      <>
                        <span class="text-text-muted">·</span>
                        <span class="text-accent capitalize">
                          {post.data.tags[0]}
                        </span>
                      </>
                    )}
                  </div>

                  {/* Title */}
                  <h2 class="text-2xl md:text-3xl font-bold text-text mb-3 group-hover:text-primary transition-colors duration-normal">
                    {post.data.title}
                  </h2>

                  {/* Excerpt */}
                  <p class="text-text-secondary line-clamp-3">
                    {post.data.description}
                  </p>

                  {/* Read More Link */}
                  <span class="inline-flex items-center gap-2 mt-4 text-primary font-medium group-hover:gap-3 transition-all duration-normal">
                    Read more
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"
                      />
                    </svg>
                  </span>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="text-center py-16">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-secondary flex items-center justify-center">
              <svg
                class="w-8 h-8 text-text-muted"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                />
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-text mb-2">No posts yet</h2>
            <p class="text-text-secondary mb-6">
              Check back soon for stories and updates
            </p>
            <a
              href="/"
              class="inline-flex px-6 py-3 bg-primary text-text-inverse font-medium rounded-lg hover:bg-primary-600 transition-colors duration-normal"
            >
              Back to Home
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-12 md:py-16 bg-secondary">
    <div class="container mx-auto px-4 max-w-4xl text-center">
      <h2 class="text-2xl font-bold text-text mb-3">Stay in the Loop</h2>
      <p class="text-text-secondary max-w-md mx-auto mb-6">
        Subscribe to get notified about new posts and upcoming drops
      </p>
      <a
        href="/#newsletter"
        class="inline-flex px-6 py-3 bg-primary text-text-inverse font-medium rounded-lg hover:bg-primary-600 transition-colors duration-normal"
      >
        Subscribe to Newsletter
      </a>
    </div>
  </section>
</BaseLayout>
