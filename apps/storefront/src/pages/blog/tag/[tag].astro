---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag } from '../../../lib/blog';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => {
    // In production, filter out drafts
    return import.meta.env.PROD ? !data.draft : true;
  });

  // Get all unique tags
  const tags = getAllTags(allPosts);

  // Generate a page for each tag
  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: getPostsByTag(allPosts, tag),
      allTags: tags,
      currentTag: tag,
    },
  }));
}

interface Props {
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
  allTags: string[];
  currentTag: string;
}

const { posts, allTags, currentTag } = Astro.props;

// Format date helper
function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

// Capitalize first letter of tag for display
function capitalizeTag(tag: string): string {
  return tag.charAt(0).toUpperCase() + tag.slice(1);
}
---

<BaseLayout
  title={`${capitalizeTag(currentTag)} Posts`}
  description={`Blog posts tagged with "${currentTag}" from Dear Margeaux`}
  rssUrl="/blog/rss.xml"
>
  <!-- Page Header -->
  <section class="bg-secondary py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="flex items-center justify-center gap-3">
        <h1 class="text-3xl md:text-4xl font-bold text-text text-center">
          The Journal
        </h1>
        <a
          href="/blog/rss.xml"
          title="Subscribe to RSS Feed"
          class="text-text-secondary hover:text-primary transition-colors duration-normal"
          aria-label="Subscribe to RSS Feed"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"
            ></path>
          </svg>
        </a>
      </div>
      <p class="text-text-secondary text-center mt-3 max-w-xl mx-auto">
        Stories, insights, and behind-the-scenes from Dear Margeaux
      </p>
    </div>
  </section>

  <!-- Tag Filter Bar -->
  <section class="py-6 border-b border-border">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-sm font-medium text-text-secondary"
          >Filter by tag:</span
        >
        <a
          href="/blog"
          class="px-3 py-1.5 text-sm font-medium rounded-full transition-colors duration-normal text-text-secondary hover:text-text hover:bg-secondary"
        >
          All
        </a>
        {
          allTags.map((tag) => (
            <a
              href={`/blog/tag/${tag}`}
              class:list={[
                'px-3 py-1.5 text-sm font-medium rounded-full transition-colors duration-normal capitalize',
                tag === currentTag
                  ? 'bg-primary text-text-inverse'
                  : 'text-text-secondary hover:text-text hover:bg-secondary',
              ]}
              aria-current={tag === currentTag ? 'page' : undefined}
            >
              {tag}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Filtered Results Header -->
  <section class="py-6 bg-background-tertiary">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="flex items-center justify-between">
        <p class="text-text-secondary">
          <span class="font-medium text-text">{posts.length}</span>
          {posts.length === 1 ? 'post' : 'posts'} tagged with
          <span class="font-medium text-accent capitalize">"{currentTag}"</span>
        </p>
        <a
          href="/blog"
          class="text-sm text-primary hover:text-primary-600 transition-colors duration-normal flex items-center gap-1"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          Clear filter
        </a>
      </div>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-4xl">
      {
        posts.length > 0 ? (
          <div class="space-y-12">
            {posts.map((post, index) => (
              <article
                class:list={[
                  'group',
                  index !== posts.length - 1 && 'pb-12 border-b border-border',
                ]}
              >
                <a href={`/blog/${post.slug}`} class="block">
                  {/* Featured Image */}
                  {post.data.image && (
                    <div class="aspect-[2/1] overflow-hidden rounded-xl mb-6">
                      <img
                        src={post.data.image}
                        alt={post.data.title}
                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    </div>
                  )}

                  {/* Post Meta */}
                  <div class="flex items-center gap-3 text-sm text-text-secondary mb-3">
                    {post.data.pinned && (
                      <>
                        <span class="inline-flex items-center gap-1 text-primary font-medium">
                          <svg
                            class="w-3.5 h-3.5"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                          >
                            <path
                              d="M10.75 2.75a.75.75 0 00-1.5 0v8.614L6.295 8.235a.75.75 0 10-1.09 1.03l4.25 4.5a.75.75 0 001.09 0l4.25-4.5a.75.75 0 00-1.09-1.03l-2.955 3.129V2.75z"
                              transform="rotate(180, 10, 10)"
                            />
                          </svg>
                          Pinned
                        </span>
                        <span class="text-text-muted">·</span>
                      </>
                    )}
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                    {post.data.tags.length > 0 && (
                      <>
                        <span class="text-text-muted">·</span>
                        <div class="flex flex-wrap gap-2">
                          {post.data.tags.map((tag) => (
                            <a
                              href={`/blog/tag/${tag.toLowerCase()}`}
                              class:list={[
                                'capitalize hover:text-primary transition-colors duration-normal',
                                tag.toLowerCase() === currentTag
                                  ? 'text-primary font-medium'
                                  : 'text-accent',
                              ]}
                              onclick="event.stopPropagation()"
                            >
                              {tag}
                            </a>
                          ))}
                        </div>
                      </>
                    )}
                  </div>

                  {/* Title */}
                  <h2 class="text-2xl md:text-3xl font-bold text-text mb-3 group-hover:text-primary transition-colors duration-normal">
                    {post.data.title}
                  </h2>

                  {/* Excerpt */}
                  <p class="text-text-secondary line-clamp-3">
                    {post.data.description}
                  </p>

                  {/* Read More Link */}
                  <span class="inline-flex items-center gap-2 mt-4 text-primary font-medium group-hover:gap-3 transition-all duration-normal">
                    Read more
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"
                      />
                    </svg>
                  </span>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="text-center py-16">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-secondary flex items-center justify-center">
              <svg
                class="w-8 h-8 text-text-muted"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                />
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-text mb-2">No posts found</h2>
            <p class="text-text-secondary mb-6">
              No posts have been tagged with "{currentTag}" yet
            </p>
            <a
              href="/blog"
              class="inline-flex px-6 py-3 bg-primary text-text-inverse font-medium rounded-lg hover:bg-primary-600 transition-colors duration-normal"
            >
              View all posts
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-12 md:py-16 bg-secondary">
    <div class="container mx-auto px-4 max-w-4xl text-center">
      <h2 class="text-2xl font-bold text-text mb-3">Stay in the Loop</h2>
      <p class="text-text-secondary max-w-md mx-auto mb-6">
        Subscribe to get notified about new posts and upcoming drops
      </p>
      <a
        href="/#newsletter"
        class="inline-flex px-6 py-3 bg-primary text-text-inverse font-medium rounded-lg hover:bg-primary-600 transition-colors duration-normal"
      >
        Subscribe to Newsletter
      </a>
    </div>
  </section>
</BaseLayout>
