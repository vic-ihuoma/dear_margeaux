---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import type { ProductListItem } from '@dear-margeaux/api';
import type { GetStaticPaths } from 'astro';

interface DisplayProduct {
  id: string;
  title: string;
  price: number;
  image?: string;
  collection?: string;
  soldOut: boolean;
}

// Sample products for development/fallback when API is unavailable
const getSampleProducts = (): DisplayProduct[] => [
  {
    id: '1',
    title: 'Classic Leather Tote',
    price: 45000,
    collection: 'Spring 2026',
    soldOut: false,
  },
  {
    id: '2',
    title: 'Mini Crossbody',
    price: 28500,
    collection: 'Spring 2026',
    soldOut: false,
  },
  {
    id: '3',
    title: 'Structured Satchel',
    price: 52000,
    collection: 'Spring 2026',
    soldOut: true,
  },
  {
    id: '4',
    title: 'Weekend Duffle',
    price: 68000,
    collection: 'Spring 2026',
    soldOut: false,
  },
  {
    id: '5',
    title: 'Evening Clutch',
    price: 32000,
    collection: 'Winter 2025',
    soldOut: true,
  },
  {
    id: '6',
    title: 'Everyday Hobo',
    price: 48000,
    collection: 'Winter 2025',
    soldOut: false,
  },
  {
    id: '7',
    title: 'Bucket Bag',
    price: 38000,
    collection: 'Winter 2025',
    soldOut: false,
  },
  {
    id: '8',
    title: 'Messenger Bag',
    price: 55000,
    collection: 'Fall 2025',
    soldOut: false,
  },
];

// Generate static paths for all available collections/drops
export const getStaticPaths: GetStaticPaths = async () => {
  // Define collection slugs for static generation
  // These correspond to the sample product collections
  // In production with real API data, this would fetch from the API to get actual drops
  const collectionSlugs = ['spring-2026', 'winter-2025', 'fall-2025'];

  return collectionSlugs.map((slug) => ({
    params: { drop: slug },
  }));
};

// Get the drop slug from the URL parameter
const { drop: dropSlug } = Astro.params;

// Helper to convert slug to collection name
function slugToCollectionName(slug: string): string {
  return slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

// Fetch products from the Merchant API or use sample data
let allProducts: DisplayProduct[] = getSampleProducts();

// Only try to fetch from API if environment variables are set
const apiUrl = import.meta.env.PUBLIC_MERCHANT_API_URL;
const apiKey = import.meta.env.PUBLIC_MERCHANT_API_KEY;

if (apiUrl && apiKey) {
  try {
    const { MerchantClient } = await import('@dear-margeaux/api');
    const client = new MerchantClient({ baseUrl: apiUrl, apiKey });

    const response = await client.getProducts({ status: 'active', limit: 50 });

    if (response.items.length > 0) {
      // For each product, fetch full details to get variants (for price and image)
      const productDetails = await Promise.all(
        response.items.map(async (item: ProductListItem) => {
          try {
            const product = await client.getProduct(item.id);
            const firstVariant = product.variants[0];

            return {
              id: product.id,
              title: product.title,
              price: firstVariant?.price_cents ?? 0,
              image: firstVariant?.image_url ?? undefined,
              collection: undefined, // Will be populated when drops are implemented (Phase 4)
              soldOut: false, // Will be determined by inventory in future
            };
          } catch {
            return null;
          }
        })
      );

      const validProducts = productDetails.filter(
        (p): p is NonNullable<typeof p> => p !== null
      );
      if (validProducts.length > 0) {
        allProducts = validProducts;
      }
    }
  } catch (error) {
    // Log error but continue with sample data
    console.error('Failed to fetch products from API:', error);
  }
}

// Get unique collections for filtering
const collections = [
  ...new Set(allProducts.map((p) => p.collection).filter(Boolean)),
];

// Find the matching collection name
const collectionName = dropSlug ? slugToCollectionName(String(dropSlug)) : null;

// Filter products by the selected drop/collection
const filteredProducts = collectionName
  ? allProducts.filter(
      (p) => p.collection?.toLowerCase() === collectionName.toLowerCase()
    )
  : allProducts;

// Check if this drop exists (has products)
const dropExists = filteredProducts.length > 0 || !collectionName;

// Determine if this is a past drop (sold out products indicate past drops)
const isPastDrop =
  filteredProducts.length > 0 && filteredProducts.every((p) => p.soldOut);
---

<BaseLayout
  title={collectionName ? `${collectionName} Collection` : 'Shop'}
  description={collectionName
    ? `Shop the ${collectionName} collection of handcrafted leather bags`
    : 'Browse our collection of handcrafted leather bags'}
>
  <!-- Page Header -->
  <section class="bg-secondary py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-6xl">
      {
        dropExists ? (
          <>
            <nav class="flex items-center justify-center gap-2 text-sm text-text-secondary mb-4">
              <a href="/shop" class="hover:text-primary transition-colors">
                Shop
              </a>
              <span>/</span>
              <span class="text-text">{collectionName}</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold text-text text-center">
              {collectionName}
            </h1>
            {isPastDrop && (
              <div class="mt-4 flex justify-center">
                <span class="px-4 py-1 text-sm font-medium text-text-muted bg-background rounded-full">
                  Past Collection
                </span>
              </div>
            )}
            <p class="text-text-secondary text-center mt-3 max-w-xl mx-auto">
              {isPastDrop
                ? 'This collection has ended. Browse our current collections for available items.'
                : `Explore the ${collectionName} collection of handcrafted leather bags`}
            </p>
          </>
        ) : (
          <>
            <h1 class="text-3xl md:text-4xl font-bold text-text text-center">
              Collection Not Found
            </h1>
            <p class="text-text-secondary text-center mt-3 max-w-xl mx-auto">
              The collection you're looking for doesn't exist or has been
              removed
            </p>
          </>
        )
      }
    </div>
  </section>

  <!-- Filters Section -->
  {
    collections.length > 0 && dropExists && (
      <section class="border-b border-border bg-background">
        <div class="container mx-auto px-4 max-w-6xl">
          <div class="flex items-center gap-4 py-4 overflow-x-auto">
            <span class="text-sm font-medium text-text-secondary shrink-0">
              Filter by:
            </span>
            <div class="flex gap-2">
              <a
                href="/shop"
                class="px-4 py-2 text-sm font-medium rounded-full border border-border text-text hover:bg-background-secondary transition-colors duration-normal"
              >
                All
              </a>
              {collections.map((collection) => {
                const slug = collection?.toLowerCase().replace(/\s+/g, '-');
                const isActive = slug === dropSlug;
                return (
                  <a
                    href={`/shop/${slug}`}
                    class:list={[
                      'px-4 py-2 text-sm font-medium rounded-full transition-colors duration-normal',
                      isActive
                        ? 'bg-primary text-text-inverse'
                        : 'border border-border text-text hover:bg-background-secondary',
                    ]}
                  >
                    {collection}
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Products Grid -->
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-6xl">
      {
        dropExists && filteredProducts.length > 0 ? (
          <>
            <div class="flex items-center justify-between mb-8">
              <p class="text-sm text-text-secondary">
                Showing {filteredProducts.length}{' '}
                {filteredProducts.length === 1 ? 'product' : 'products'}
              </p>
            </div>

            <ProductGrid columns={4} gap="md">
              {filteredProducts.map((product) => (
                <ProductCard
                  id={product.id}
                  title={product.title}
                  price={product.price}
                  image={product.image}
                  collection={product.collection}
                  soldOut={product.soldOut}
                />
              ))}
            </ProductGrid>
          </>
        ) : (
          <div class="text-center py-16">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-secondary flex items-center justify-center">
              <svg
                class="w-8 h-8 text-text-muted"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"
                />
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-text mb-2">
              {dropExists
                ? 'No products in this collection'
                : 'Collection not found'}
            </h2>
            <p class="text-text-secondary mb-6">
              {dropExists
                ? 'Check back soon or browse our other collections'
                : "The collection you're looking for doesn't exist"}
            </p>
            <a
              href="/shop"
              class="inline-flex px-6 py-3 bg-primary text-text-inverse font-medium rounded-lg hover:bg-primary-600 transition-colors duration-normal"
            >
              View All Products
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-12 md:py-16 bg-secondary">
    <div class="container mx-auto px-4 max-w-6xl text-center">
      <h2 class="text-2xl font-bold text-text mb-3">Don't Miss a Drop</h2>
      <p class="text-text-secondary max-w-md mx-auto mb-6">
        Be the first to know when new collections are released
      </p>
      <a
        href="/#newsletter"
        class="inline-flex px-6 py-3 bg-primary text-text-inverse font-medium rounded-lg hover:bg-primary-600 transition-colors duration-normal"
      >
        Join the Waitlist
      </a>
    </div>
  </section>
</BaseLayout>
