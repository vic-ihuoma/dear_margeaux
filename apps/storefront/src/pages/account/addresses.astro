---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddressList from '../../components/AddressList';
import AccountNav from '../../components/AccountNav';
---

<BaseLayout
  title="Saved Addresses"
  description="Manage your saved shipping addresses for Dear Margeaux"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Page Header -->
    <div class="mb-8">
      <nav class="text-sm text-text-muted mb-4">
        <ol class="flex items-center gap-2">
          <li>
            <a href="/" class="hover:text-primary transition-colors">Home</a>
          </li>
          <li><span>/</span></li>
          <li><span class="text-text-primary">Account</span></li>
        </ol>
      </nav>
      <h1 class="text-3xl font-semibold text-text-primary">My Account</h1>
    </div>

    <!-- Account Content -->
    <div class="grid lg:grid-cols-4 gap-8">
      <!-- Sidebar Navigation -->
      <div class="lg:col-span-1">
        <AccountNav client:load currentPage="addresses" />
      </div>

      <!-- Main Content -->
      <div class="lg:col-span-3">
        <AddressList client:load />
      </div>
    </div>
  </div>
</BaseLayout>
