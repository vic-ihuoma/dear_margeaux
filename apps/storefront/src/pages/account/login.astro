---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoginForm from '../../components/LoginForm';

// Get any error/success messages from query params
const error = Astro.url.searchParams.get('error');
const registered = Astro.url.searchParams.get('registered');
const redirectTo = Astro.url.searchParams.get('redirect') || '/account/orders';
---

<BaseLayout title="Sign In" description="Sign in to your Dear Margeaux account">
  <div
    class="min-h-[calc(100vh-200px)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8"
  >
    <div class="max-w-md w-full space-y-8">
      <!-- Header -->
      <div class="text-center">
        <h1 class="text-3xl font-semibold text-text-primary">Welcome Back</h1>
        <p class="mt-2 text-text-secondary">
          Sign in to view your orders and manage your account
        </p>
      </div>

      <!-- Success message (after registration) -->
      {
        registered && (
          <div class="p-4 bg-success/10 border border-success/20 rounded-lg">
            <p class="text-sm text-success">
              Account created successfully! Please sign in to continue.
            </p>
          </div>
        )
      }

      <!-- Error message -->
      {
        error && (
          <div class="p-4 bg-error/10 border border-error/20 rounded-lg">
            <p class="text-sm text-error">
              {error === 'invalid' &&
                'Invalid email or password. Please try again.'}
              {error === 'session_expired' &&
                'Your session has expired. Please sign in again.'}
              {error !== 'invalid' &&
                error !== 'session_expired' &&
                'An error occurred. Please try again.'}
            </p>
          </div>
        )
      }

      <!-- Login Form -->
      <div
        class="bg-background-secondary rounded-xl shadow-sm border border-border p-8"
      >
        <LoginForm client:load redirectTo={redirectTo} />
      </div>

      <!-- Register link -->
      <p class="text-center text-sm text-text-secondary">
        Don&apos;t have an account?{' '}
        <a
          href={`/account/register${redirectTo !== '/account/orders' ? `?redirect=${encodeURIComponent(redirectTo)}` : ''}`}
          class="font-medium text-primary hover:text-primary-600 transition-colors"
        >
          Create one
        </a>
      </p>

      <!-- Guest checkout note -->
      <div class="text-center">
        <p class="text-sm text-text-muted">
          You can also checkout as a guest without creating an account.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
