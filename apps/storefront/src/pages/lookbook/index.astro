---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Get all published lookbooks, sorted by date (newest first)
const allLookbooks = await getCollection('lookbook', ({ data }) => {
  // In production, filter out drafts
  return import.meta.env.PROD ? !data.draft : true;
});

const lookbooks = allLookbooks.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Format date helper
function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
  });
}
---

<BaseLayout
  title="Lookbook"
  description="Visual campaigns and editorial content from Dear Margeaux collections"
>
  <!-- Page Header -->
  <section class="bg-secondary py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-6xl">
      <h1 class="text-3xl md:text-4xl font-bold text-text text-center">
        Lookbook
      </h1>
      <p class="text-text-secondary text-center mt-3 max-w-xl mx-auto">
        Visual stories from our collections
      </p>
    </div>
  </section>

  <!-- Lookbook Gallery -->
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-6xl">
      {
        lookbooks.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {lookbooks.map((lookbook) => (
              <article class="group">
                <a href={`/lookbook/${lookbook.slug}`} class="block">
                  {/* Cover Image */}
                  <div class="aspect-[4/5] overflow-hidden rounded-xl mb-4 bg-secondary">
                    {lookbook.data.images.length > 0 ? (
                      <img
                        src={lookbook.data.images[0]}
                        alt={lookbook.data.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center">
                        <svg
                          class="w-16 h-16 text-text-muted"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="1"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
                          />
                        </svg>
                      </div>
                    )}
                  </div>

                  {/* Lookbook Info */}
                  <div class="flex items-center justify-between">
                    <div>
                      <h2 class="text-xl font-bold text-text group-hover:text-primary transition-colors duration-normal">
                        {lookbook.data.title}
                      </h2>
                      <p class="text-sm text-text-secondary mt-1">
                        {formatDate(lookbook.data.date)}
                      </p>
                    </div>
                    <div class="flex items-center gap-1 text-text-muted">
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
                        />
                      </svg>
                      <span class="text-sm">{lookbook.data.images.length}</span>
                    </div>
                  </div>

                  {/* View Lookbook Link */}
                  <span class="inline-flex items-center gap-2 mt-3 text-primary text-sm font-medium group-hover:gap-3 transition-all duration-normal">
                    View Lookbook
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"
                      />
                    </svg>
                  </span>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="text-center py-16">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-secondary flex items-center justify-center">
              <svg
                class="w-8 h-8 text-text-muted"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
                />
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-text mb-2">
              No lookbooks yet
            </h2>
            <p class="text-text-secondary mb-6">
              Check back soon for visual stories from our collections
            </p>
            <a
              href="/shop"
              class="inline-flex px-6 py-3 bg-primary text-text-inverse font-medium rounded-lg hover:bg-primary-600 transition-colors duration-normal"
            >
              Shop Now
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- Shop CTA -->
  <section class="py-12 md:py-16 bg-secondary">
    <div class="container mx-auto px-4 max-w-4xl text-center">
      <h2 class="text-2xl font-bold text-text mb-3">Shop the Collection</h2>
      <p class="text-text-secondary max-w-md mx-auto mb-6">
        Explore our current drop and find your perfect piece
      </p>
      <a
        href="/shop"
        class="inline-flex px-6 py-3 bg-primary text-text-inverse font-medium rounded-lg hover:bg-primary-600 transition-colors duration-normal"
      >
        Browse All Products
      </a>
    </div>
  </section>
</BaseLayout>
