---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Subscription Confirmed"
  description="Your newsletter subscription has been confirmed."
>
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-2xl text-center">
      <!-- Success Icon -->
      <div
        class="w-20 h-20 mx-auto mb-8 rounded-full bg-status-success/10 flex items-center justify-center"
      >
        <svg
          class="w-10 h-10 text-status-success"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <h1 class="text-3xl md:text-4xl font-bold text-text mb-4">
        You're All Set!
      </h1>

      <p class="text-lg text-text-secondary mb-8">
        Thank you for confirming your subscription. You're now on the list to
        receive updates about new collections, exclusive drops, and
        behind-the-scenes content from Dear Margeaux.
      </p>

      <!-- What to Expect -->
      <div class="bg-secondary rounded-xl p-6 mb-8 text-left">
        <h2 class="text-lg font-semibold text-text mb-4">What to expect</h2>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span
              class="w-6 h-6 shrink-0 rounded-full bg-primary text-text-inverse flex items-center justify-center"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
                ></path>
              </svg>
            </span>
            <span class="text-text-secondary"
              >Early access notifications for upcoming drops and limited
              editions.</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span
              class="w-6 h-6 shrink-0 rounded-full bg-primary text-text-inverse flex items-center justify-center"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                ></path>
              </svg>
            </span>
            <span class="text-text-secondary"
              >Stories from our journal about craftsmanship and inspiration.</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span
              class="w-6 h-6 shrink-0 rounded-full bg-primary text-text-inverse flex items-center justify-center"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"
                ></path>
              </svg>
            </span>
            <span class="text-text-secondary"
              >Exclusive offers and first looks at new designs.</span
            >
          </li>
        </ul>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/shop"
          class="inline-flex items-center justify-center px-8 py-3 bg-primary text-text-inverse font-medium rounded-lg hover:bg-primary-600 transition-colors duration-normal"
        >
          Explore the Shop
        </a>
        <a
          href="/blog"
          class="inline-flex items-center justify-center px-8 py-3 border border-border text-text font-medium rounded-lg hover:border-primary hover:text-primary transition-colors duration-normal"
        >
          Read the Journal
        </a>
      </div>

      <!-- Home Link -->
      <div class="mt-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-primary transition-colors"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Homepage
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
