# Dear Margeaux Storefront Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# MERCHANT API CONFIGURATION
# =============================================================================

# The base URL for the Merchant.dev API
# Development: http://localhost:8787
# Production: https://api.dearmargeaux.com
PUBLIC_MERCHANT_API_URL=http://localhost:8787

# Public API key for storefront (read-only access)
# Use pk_ prefix for public keys (safe to expose in browser)
# Development: pk_dev_xxxxx (from local Merchant dev server)
# Production: pk_live_xxxxx (from Cloudflare Merchant deployment)
PUBLIC_MERCHANT_API_KEY=pk_dev_xxxxx

# =============================================================================
# STRIPE CONFIGURATION
# =============================================================================

# Stripe publishable key for client-side checkout
# Development: pk_test_xxxxx (from Stripe Dashboard > Developers > API Keys)
# Production: pk_live_xxxxx (from Stripe Dashboard in live mode)
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# =============================================================================
# SENTRY ERROR MONITORING
# =============================================================================

# Sentry Data Source Name (DSN)
# Get from https://sentry.io > Project Settings > Client Keys
PUBLIC_SENTRY_DSN=

# Environment name for error grouping
# Values: development, staging, production
PUBLIC_SENTRY_ENVIRONMENT=development

# Optional: Release version for tracking deployments
# Usually set during build/deploy (e.g., git SHA or version number)
PUBLIC_SENTRY_RELEASE=

# For source map uploads during build (not exposed to browser)
# Get auth token from https://sentry.io > Settings > Auth Tokens
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

# Site URL (used for SEO, sitemap, and canonical URLs)
# Development: http://localhost:4321
# Production: https://dearmargeaux.com
SITE_URL=http://localhost:4321
